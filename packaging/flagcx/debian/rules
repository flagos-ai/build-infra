# One container builds one backend, so debian/control holds exactly one stanza
# pair and there is no vendor ladder here — the vendor is selected entirely by
# DEB_MAKE_FLAG, which build-flagcx-deb.sh exports from backends.yaml.
#
# Every path the FlagCX Makefile needs is either a knob it already has
# (BUILDDIR, DESTDIR, INC_DESTDIR, COMPILE_KERNEL) or lives in backends.yaml.
# Nothing about a vendor is decided in this file.

export DH_VERBOSE = 1

PKG := $(shell dpkg-parsechangelog -SSource)

# The library filename carries the upstream release, not the Debian version:
# the pre-release suffix and the revision are ordering concerns, and a `~` has
# no business in a shared object's name. 0.14.0~rc1.post1-1 -> 0.14.0.
LIBVER := $(shell dpkg-parsechangelog -SVersion | sed -e 's/-[^-]*$$//' -e 's/~.*//')

BUILDDIR := $(CURDIR)/build
LIBDIR   := $(BUILDDIR)/lib
INSTALL  := $(CURDIR)/debian/$(PKG)

# DEB_MAKE_FLAG / DEB_MAKE_ENV come from `deb-config.py --build-inputs`.
# They are passed as make *command-line* variables rather than environment, so
# they outrank the `?=` in makefiles/*.mk and beat the Makefile's own ifeq
# ladder, which pre-assigns DEVICE_HOME/CCL_HOME before including the vendor
# .mk (that is why an unset var there becomes /lib64 instead of the default).
ifeq ($(strip $(DEB_MAKE_FLAG)),)
$(error DEB_MAKE_FLAG is unset: the vendor flag did not survive dpkg-buildpackage -- unrecognized DEB_* names are within its remit to sanitize, and losing this one would expand to a bare `=1` that make rejects without naming it)
endif

MAKE_ARGS := BUILDDIR=$(BUILDDIR) COMPILE_KERNEL=0 $(DEB_MAKE_ENV) $(DEB_MAKE_FLAG)=1

%:
	dh $@

# The FlagCX tree has a setup.py, so dh's auto-detection would otherwise run
# `python3 setup.py build` and package a Python project instead of the library.
override_dh_auto_configure:
	@:

override_dh_auto_build:
	$(MAKE) $(MAKE_ARGS) all

override_dh_auto_test:
	@:

# dwz deduplicates DWARF across a package's binaries to shrink debug info, and
# it is the one step whose output is not shipped: dh_strip runs right after it.
# The Metax linker interleaves allocatable and non-allocatable sections, which
# dwz refuses outright, so the step can only lose the build.
override_dh_dwz:
	@:

override_dh_auto_clean:
	# `clean:` dereferences DESTDIR (Makefile:371), so it must be passed here
	# too — with an unset one it would try to remove /libflagcx.so.
	$(MAKE) $(MAKE_ARGS) DESTDIR=$(INSTALL)/usr/lib clean

override_dh_auto_install:
	$(MAKE) $(MAKE_ARGS) install \
		PREFIX=/usr DESTDIR=$(INSTALL)/usr/lib INC_DESTDIR=$(INSTALL)/usr/include/flagcx
	# `install:` is a flat `cp`, so the headers land un-namespaced under
	# .../usr/include/flagcx already; they belong to -dev, not to the runtime
	# package.
	mkdir -p $(CURDIR)/debian/$(PKG)-dev/usr/include
	mv $(INSTALL)/usr/include/flagcx $(CURDIR)/debian/$(PKG)-dev/usr/include/
	rmdir $(INSTALL)/usr/include
	bash debian/patch-soname.sh "$(INSTALL)/usr/lib/libflagcx.so" "$(LIBVER)" \
		"$(CURDIR)/debian/$(PKG)-dev"

# The vendor libraries are supplied by the site's driver and SDK, not by
# Ubuntu, so dpkg-shlibdeps has no shlibs entry for them and treats that as a
# hard error. --ignore-missing-info is the flag that says so: as a passthrough
# it applies to dpkg-shlibdeps itself, and it keeps the check for everything
# that *should* resolve (libc6, libstdc++6, libgcc-s1).
override_dh_shlibdeps:
	dh_shlibdeps -- --ignore-missing-info
