# FlagCX build-toolchain image for the cambricon-neuware4.7.2 wheel: the
# vendor-SDK twin of Containerfile.builder, self-contained on ubuntu:22.04 so
# the wheel's glibc floor is 2.35 and it installs on the bundle's physical
# 22.04 hosts. The SDK is 4.7.2's own ubuntu22.04 debs (filestore
# cambricon/u2204) — the 24.04 SDK the runtime carries would link GLIBC_2.38.
# No clang/bitcode — cambricon.mk compiles nothing device-side.

FROM ubuntu:22.04

# After FROM: a pre-FROM ARG is not in scope for the RUNs below.
ARG FILE_STORE=https://resource.flagos.net/repository/flagos-filestore/cambricon/u2204
ARG BUILDER_ASSERT
ARG TORCH_PIN
ARG TORCH_MLU_PIN
ARG TORCH_MLU_OPS_PIN
ARG NUMPY_PIN
ARG PANDAS_PIN
ARG VENDOR_PYPI
ARG EXTRA_PYPI
ARG PYTHON_VERSION=3.12
ARG RUNTIME_PREREQS

# Never baked as ENV: the proxy is a build-time fact of one RUN.
ARG HTTPS_PROXY=
ARG http_proxy=
ARG https_proxy=
# The node's own value, not a second copy here that could silently win.
ARG no_proxy=

# python 3.12 comes from deadsnakes on jammy, the way Containerfile.builder does
# it. libgflags/libgoogle-glog are the build-only headers torch's c10/util
# headers reach.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl wget git unzip \
        build-essential gcc g++ cmake; \
    curl -fsSL \
         "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
         | gpg --dearmor -o /etc/apt/trusted.gpg.d/deadsnakes.gpg; \
    echo "deb https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" \
         > /etc/apt/sources.list.d/deadsnakes.list; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        libgflags-dev libgoogle-glog-dev \
        libnuma1 libgomp1 libgfortran5; \
    rm -rf /var/lib/apt/lists/*

# The SDK, 4.7.2's ubuntu22.04 debs, in the order base/cambricon-neuware4.7.2
# installs them: the toolkit deb drops a file:// repo whose cntoolkit-cloud
# meta-package pulls cnrt/cndrv/cndev/cnbin, then the rest install against it.
ENV TOOLKIT=cntoolkit_4.7.2-1.ubuntu22.04_amd64.deb
ENV PKGS="cnnl_2.2.14-1.ubuntu22.04_amd64.deb \
  cnnlextra_2.4.0-1.ubuntu22.04_amd64.deb \
  mluops_1.12.0-1.ubuntu22.04_amd64.deb \
  cncl_1.30.8-1.ubuntu22.04_amd64.deb \
  cnclep_1.4.0-1.ubuntu22.04_amd64.deb \
  cncv_2.12.1-1.ubuntu22.04_amd64.deb"
RUN set -eux; \
    curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o toolkit.deb "${FILE_STORE}/${TOOLKIT}"; \
    dpkg -i toolkit.deb; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y cntoolkit-cloud; \
    rm -f toolkit.deb
RUN set -eux; \
    for pkg in ${PKGS}; do \
        curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
            -o "${pkg}" "${FILE_STORE}/${pkg}"; \
        dpkg -i "${pkg}"; \
        rm -f "${pkg}"; \
    done; \
    DEBIAN_FRONTEND=noninteractive apt-get install -yf; \
    rm -rf /var/lib/apt/lists/*

# The row's SDK assert, checked here rather than as an unresolved symbol later.
RUN set -eux; \
    for path in ${BUILDER_ASSERT}; do \
        test -e "$path" || { echo "assert: $path is missing" >&2; exit 1; }; \
    done

# The same env base/cambricon-neuware4.7.2 bakes; there is no profile.d script,
# so ENV is the whole of it (unlike DTK).
ENV NEUWARE_HOME="/usr/local/neuware" \
    PATH="/usr/local/neuware/bin:${PATH}" \
    LD_LIBRARY_PATH="/usr/local/neuware/lib64"

# Interpreter and torch stack, the things the runtime image used to provide.
# prereqs+numpy+pandas from the general mirror, torch/torch-mlu/torch-mlu-ops
# from the vendor index LAST so +cpu/+torch2.11.0 resolves there while their own
# deps resolve on the mirror. torch-mlu is the bridge torch_mlu import loads,
# which is the step that binds the wheel to the SDK's libcncl/libcnrt; pandas
# rides along because torch_mlu's autoload pulls a profiler module that imports
# it but the vendor wheel does not declare it.
ENV VIRTUAL_ENV=/flagos \
    PATH="/flagos/bin:${PATH}"
RUN set -eux; \
    python3.12 -m ensurepip --upgrade; \
    python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools; \
    python3.12 -m venv /flagos; \
    /flagos/bin/pip install --no-cache-dir --upgrade pip; \
    /flagos/bin/pip install --no-cache-dir --index-url "${EXTRA_PYPI}" \
        ${RUNTIME_PREREQS} ${NUMPY_PIN} ${PANDAS_PIN} wheel packaging; \
    for i in 1 2 3; do \
        PIP_INDEX_URL="${EXTRA_PYPI}" \
        PIP_EXTRA_INDEX_URL="${VENDOR_PYPI}" \
        PIP_TRUSTED_HOST=resource.flagos.net \
        /flagos/bin/pip install --no-cache-dir --pre \
            "${TORCH_PIN}" ${TORCH_MLU_PIN} ${TORCH_MLU_OPS_PIN} && break; \
        echo "torch install attempt $i failed, retrying in 10s..."; sleep 10; \
    done

# The probe the wheel build stands in for: import the pinned torch against the
# SDK. import torch_mlu is the SDK-floor proof — it dlopens _MLUC, whose NEEDED
# are libcncl/libcnrt/libcndrv — and is asserted against importlib.metadata, not
# __version__, because a vendor torch may drop the local segment.
RUN set -eu; \
    printf '%s\n' \
      'import importlib' \
      'import importlib.metadata' \
      'import os' \
      'import sys' \
      'import sysconfig' \
      '' \
      'for name in ("torch", "setuptools", "setuptools_scm", "wheel", "packaging",' \
      '             "torch.utils.cpp_extension"):' \
      '    importlib.import_module(name)' \
      '' \
      'header = os.path.join(sysconfig.get_paths()["include"], "Python.h")' \
      'assert os.path.exists(header), "no Python.h under %s" % header' \
      '' \
      'want_minor = int(os.environ["PYTHON_VERSION"].split(".", 1)[1])' \
      'assert sys.version_info[:2] == (3, want_minor), "the venv is %s, the row says %s" % (sys.version_info[:2], os.environ["PYTHON_VERSION"])' \
      '' \
      'import torch' \
      'want_torch = os.environ["TORCH_PIN"].split("==", 1)[1]' \
      'have_torch = importlib.metadata.version("torch")' \
      'assert have_torch == want_torch, "torch %s, the row pins %s" % (have_torch, want_torch)' \
      '' \
      'import torch_mlu' \
      'print(">>> build env: %s, cp3%d, torch %s (metadata %s), torch_mlu %s"' \
      '      % (sys.executable, want_minor, torch.__version__,' \
      '         have_torch, importlib.metadata.version("torch_mlu")))' \
    | TORCH_DEVICE_BACKEND_AUTOLOAD=0 PYTHON_VERSION="${PYTHON_VERSION}" \
      TORCH_PIN="${TORCH_PIN}" /flagos/bin/python -
