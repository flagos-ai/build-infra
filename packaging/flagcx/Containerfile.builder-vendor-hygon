# FlagCX build-toolchain image for the hygon-dtk26.04 wheel: the vendor-SDK twin
# of Containerfile.builder, self-contained on ubuntu:22.04 so the wheel's glibc
# floor is 2.35 and it installs on the bundle's physical 22.04 hosts. No
# clang/LLVM/NCCL/bitcode — du.mk compiles .cu through DTK's own nvcc.

FROM ubuntu:22.04

# After FROM: a pre-FROM ARG is not in scope for the RUNs below.
ARG FILE_STORE=https://resource.flagos.net/repository/flagos-filestore
ARG BUILDER_ASSERT
ARG TORCH_PIN
ARG NUMPY_PIN
ARG VENDOR_PYPI
ARG EXTRA_PYPI
ARG PYTHON_VERSION=3.10
ARG RUNTIME_PREREQS

# Never baked as ENV: the proxy is a build-time fact of one RUN.
ARG HTTPS_PROXY=
ARG http_proxy=
ARG https_proxy=
# The node's own value, not a second copy here that could silently win.
ARG no_proxy=

# python 3.10 is jammy's own (no PPA). The runtime libs are what
# base/hygon-dtk26.04 installs — torch's DTK build links them, and the probe's
# first `import torch` fails without them. libgflags/libgoogle-glog are the
# build-only headers torch's c10/util headers reach.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl git \
        build-essential gcc g++ cmake \
        python3.10 python3.10-venv python3.10-dev \
        libgflags-dev libgoogle-glog-dev \
        libnuma1 libgfortran5 libdrm-amdgpu1 libdw1 libelf1 libpciaccess0 \
        pciutils; \
    rm -rf /var/lib/apt/lists/*

# dtk_llvm (aillvm) is deliberately not installed: it serves hipcc/amdgpu JIT,
# and the du build compiles .cu through DTK's nvcc.
ARG SDK_PACKAGE=DTK-26.04-Ubuntu22.04-x86_64.tar.gz
RUN set -eux; \
    curl -fsSL --retry 5 --connect-timeout 15 -o /dtk.tar.gz \
        "${FILE_STORE}/hygon/${SDK_PACKAGE}"; \
    tar xzf /dtk.tar.gz -C /opt; \
    ln -sf /opt/dtk-26.04 /opt/dtk; \
    rm /dtk.tar.gz

# The row's SDK assert, checked here rather than as an unresolved symbol later.
RUN set -eux; \
    for path in ${BUILDER_ASSERT}; do \
        test -e "$path" || { echo "assert: $path is missing" >&2; exit 1; }; \
    done

# Capture DTK's env into profile.d (same as base/hygon-dtk26.04): the wheel
# build sources it before `import torch`, and it is where libgalaxyhip.so's
# LD_LIBRARY_PATH comes from.
SHELL ["/bin/bash", "-c"]
RUN env_before=$(env | sort) && \
    set -a && . /opt/dtk/env.sh > /dev/null 2>&1 || true && set +a && \
    env_after=$(env | sort) && \
    printf '%s\n' "$env_before" > /tmp/_v_before && \
    printf '%s\n' "$env_after" > /tmp/_v_after && \
    comm -13 /tmp/_v_before /tmp/_v_after \
      | grep -v '^_\|^PWD=\|^SHLVL=\|^OLDPWD=' \
      | while IFS='=' read -r var val; do \
          printf 'export %s="%s"\n' "$var" "$val"; \
        done \
      > /etc/profile.d/vendor.sh && \
    rm -f /tmp/_v_before /tmp/_v_after && \
    echo "vendor.sh: captured $(wc -l < /etc/profile.d/vendor.sh) env vars"
SHELL ["/bin/sh", "-c"]

# Interpreter and torch, the two things the runtime image used to provide.
# /flagos is the same path the runtime/Containerfile.wheel use. prereqs+numpy
# from the general mirror, torch from the vendor index LAST so +dtk2604 resolves
# there while its own deps resolve on the mirror.
ENV VIRTUAL_ENV=/flagos \
    PATH="/flagos/bin:${PATH}"
RUN set -eux; \
    python3.10 -m venv /flagos; \
    /flagos/bin/pip install --no-cache-dir --upgrade pip; \
    /flagos/bin/pip install --no-cache-dir --index-url "${EXTRA_PYPI}" \
        ${RUNTIME_PREREQS} ${NUMPY_PIN} wheel packaging; \
    for i in 1 2 3; do \
        PIP_INDEX_URL="${EXTRA_PYPI}" \
        PIP_EXTRA_INDEX_URL="${VENDOR_PYPI}" \
        PIP_TRUSTED_HOST=resource.flagos.net \
        /flagos/bin/pip install --no-cache-dir --pre "${TORCH_PIN}" && break; \
        echo "torch install attempt $i failed, retrying in 10s..."; sleep 10; \
    done

# The probe the wheel build stands in for. The torch pin is asserted against
# importlib.metadata, not torch.__version__: DTK's torch drops the local segment
# (reports "2.9.0", not "+das.opt1.dtk2604"), which only dist-info METADATA
# keeps.
RUN set -eu; \
    if [ -f /etc/profile.d/vendor.sh ]; then . /etc/profile.d/vendor.sh; fi; \
    printf '%s\n' \
      'import importlib' \
      'import importlib.metadata' \
      'import os' \
      'import sys' \
      'import sysconfig' \
      '' \
      'for name in ("torch", "setuptools", "setuptools_scm", "wheel", "packaging",' \
      '             "torch.utils.cpp_extension"):' \
      '    importlib.import_module(name)' \
      '' \
      'header = os.path.join(sysconfig.get_paths()["include"], "Python.h")' \
      'assert os.path.exists(header), "no Python.h under %s" % header' \
      '' \
      'want_minor = int(os.environ["PYTHON_VERSION"].split(".", 1)[1])' \
      'assert sys.version_info[:2] == (3, want_minor), "the venv is %s, the row says %s" % (sys.version_info[:2], os.environ["PYTHON_VERSION"])' \
      '' \
      'import torch' \
      'want_torch = os.environ["TORCH_PIN"].split("==", 1)[1]' \
      'have_torch = importlib.metadata.version("torch")' \
      'assert have_torch == want_torch, "torch %s, the row pins %s" % (have_torch, want_torch)' \
      'print(">>> build env: %s, cp3%d, torch %s (metadata %s), setuptools_scm %s"' \
      '      % (sys.executable, want_minor, torch.__version__,' \
      '         have_torch,' \
      '         importlib.metadata.version("setuptools_scm")))' \
    | TORCH_DEVICE_BACKEND_AUTOLOAD=0 PYTHON_VERSION="${PYTHON_VERSION}" \
      TORCH_PIN="${TORCH_PIN}" /flagos/bin/python -
