# FlagCX build-toolchain image for the two metax rows' wheels: the vendor-SDK
# twin of Containerfile.builder, self-contained on ubuntu:22.04 so the wheel's
# glibc floor is 2.35 and it installs on the bundle's physical 22.04 hosts. No
# clang/LLVM/NCCL/bitcode — metax.mk compiles .cu through MACA's own mxcc.

FROM ubuntu:22.04

# After FROM: a pre-FROM ARG is not in scope for the RUNs below.
ARG FILE_STORE=https://resource.flagos.net/repository/flagos-filestore/metax
ARG SDK_VERSION
ARG BUILDER_ASSERT
ARG TORCH_PIN
ARG NUMPY_PIN
ARG VENDOR_PYPI
ARG EXTRA_PYPI
ARG PYTHON_VERSION=3.12
ARG RUNTIME_PREREQS

# Never baked as ENV: the proxy is a build-time fact of one RUN.
ARG HTTPS_PROXY=
ARG http_proxy=
ARG https_proxy=
# The node's own value, not a second copy here that could silently win.
ARG no_proxy=

# python 3.12 via deadsnakes on jammy (jammy's own is 3.10), the way
# Containerfile.builder-vendor-cambricon does it. libgflags/libgoogle-glog are
# the build-only headers torch's c10/util headers reach; libnuma1 is a NEEDED of
# the SDK's libmcanalyzer.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl wget git unzip \
        build-essential gcc g++ cmake; \
    curl -fsSL \
         "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
         | gpg --dearmor -o /etc/apt/trusted.gpg.d/deadsnakes.gpg; \
    echo "deb https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" \
         > /etc/apt/sources.list.d/deadsnakes.list; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
        libgflags-dev libgoogle-glog-dev \
        libnuma1 libgomp1 libgfortran5 libelf1; \
    rm -rf /var/lib/apt/lists/*

# The SDK tarball's every deb payloads to /opt/maca-<ver>/ (3.8.1.3 -> maca-3.8.1,
# 3.7.2.0 -> maca-3.7.2), so all of them can be dpkg -x'd straight into the same
# tree. dpkg -x rather than dpkg -i: -i runs postinst, which would fire each
# deb's EULA prompt under a build shell that has no tty, while -x skips it — the
# two things postinst does for the SDK root (the /opt/maca symlink and the
# lib64 -> lib symlink) are replicated below. Extracting every deb instead of the
# vendor's own -i list is deliberate: the pinned torch's libs NEED libmxomp,
# libmxc-runtime64 and libmpi, which no single minimal set carries.
RUN set -eux; \
    curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors \
        -o /maca-sdk.tar.xz "${FILE_STORE}/maca-sdk-${SDK_VERSION}-deb-x86_64.tar.xz"; \
    tar xf /maca-sdk.tar.xz -C /tmp; \
    cd "/tmp/maca-sdk-${SDK_VERSION}"; \
    for deb in deb/*.amd64.deb; do dpkg -x "$deb" /opt/maca-${SDK_VERSION%.*}; done; \
    ln -s -T /opt/maca-${SDK_VERSION%.*} /opt/maca; \
    ln -s -T lib /opt/maca/lib64; \
    rm -f /maca-sdk.tar.xz; \
    rm -rf "/tmp/maca-sdk-${SDK_VERSION}"

# The row's SDK assert, checked here rather than as an unresolved symbol later.
RUN set -eux; \
    for path in ${BUILDER_ASSERT}; do \
        test -e "$path" || { echo "assert: $path is missing" >&2; exit 1; }; \
    done

# The same env base/metax-* bakes; MACA has no profile.d script, so ENV is the
# whole of it. mxgpu_llvm/bin is where mxcc (metax.mk's DEVICE_COMPILER) lives.
ENV PATH="/opt/maca/mxgpu_llvm/bin:/opt/maca/bin:${PATH}" \
    MACA_PATH="/opt/maca" \
    LD_LIBRARY_PATH="/opt/maca/lib:/opt/maca/mxgpu_llvm/lib"

# Interpreter and torch, the things the runtime image used to provide. prereqs+
# numpy from the general mirror, torch from the vendor index LAST so
# +metax3.x resolves there while its own deps resolve on the mirror. The build
# reads torch through _build_config.py's USE_METAX_ADAPTOR branch, which
# hardcodes /opt/maca/include and /opt/maca/lib64 — both the symlinks above.
ENV VIRTUAL_ENV=/flagos \
    PATH="/flagos/bin:${PATH}"
RUN set -eux; \
    python3.12 -m ensurepip --upgrade; \
    python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools; \
    python3.12 -m venv /flagos; \
    /flagos/bin/pip install --no-cache-dir --upgrade pip; \
    /flagos/bin/pip install --no-cache-dir --index-url "${EXTRA_PYPI}" \
        ${RUNTIME_PREREQS} ${NUMPY_PIN} wheel packaging; \
    for i in 1 2 3; do \
        PIP_INDEX_URL="${EXTRA_PYPI}" \
        PIP_EXTRA_INDEX_URL="${VENDOR_PYPI}" \
        PIP_TRUSTED_HOST=resource.flagos.net \
        /flagos/bin/pip install --no-cache-dir --pre "${TORCH_PIN}" && break; \
        echo "torch install attempt $i failed, retrying in 10s..."; sleep 10; \
    done

# The probe the wheel build stands in for: import the pinned torch against the
# SDK. The metax torch NEEDs the SDK's mcruntime/mccompiler/mccl, so this import
# is the SDK-floor proof. The pin is asserted against importlib.metadata, not
# __version__, because a vendor torch may drop the local segment.
RUN set -eu; \
    printf '%s\n' \
      'import importlib' \
      'import importlib.metadata' \
      'import os' \
      'import sys' \
      'import sysconfig' \
      '' \
      'for name in ("torch", "setuptools", "setuptools_scm", "wheel", "packaging",' \
      '             "torch.utils.cpp_extension"):' \
      '    importlib.import_module(name)' \
      '' \
      'header = os.path.join(sysconfig.get_paths()["include"], "Python.h")' \
      'assert os.path.exists(header), "no Python.h under %s" % header' \
      '' \
      'want_minor = int(os.environ["PYTHON_VERSION"].split(".", 1)[1])' \
      'assert sys.version_info[:2] == (3, want_minor), "the venv is %s, the row says %s" % (sys.version_info[:2], os.environ["PYTHON_VERSION"])' \
      '' \
      'import torch' \
      'want_torch = os.environ["TORCH_PIN"].split("==", 1)[1]' \
      'have_torch = importlib.metadata.version("torch")' \
      'assert have_torch == want_torch, "torch %s, the row pins %s" % (have_torch, want_torch)' \
      'print(">>> build env: %s, cp3%d, torch %s (metadata %s)"' \
      '      % (sys.executable, want_minor, torch.__version__, have_torch))' \
    | TORCH_DEVICE_BACKEND_AUTOLOAD=0 PYTHON_VERSION="${PYTHON_VERSION}" \
      TORCH_PIN="${TORCH_PIN}" /flagos/bin/python -
