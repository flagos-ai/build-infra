# FlagCX build-toolchain image for the amd-rocm7.2.4 wheel: the vendor-SDK twin
# of Containerfile.builder, self-contained on ubuntu:22.04 so the wheel's glibc
# floor is 2.35 and it installs on the bundle's physical 22.04 hosts. No
# clang/LLVM/NCCL/bitcode — amd.mk compiles through hipcc, and this row ships
# no device bitcode, so the builder's proof is the torch/SDK import (the same
# vendor-row proof hygon's is).

FROM ubuntu:22.04

# After FROM: a pre-FROM ARG is not in scope for the RUNs below.
ARG BUILDER_ASSERT
ARG TORCH_PIN
ARG NUMPY_PIN
ARG VENDOR_PYPI
ARG EXTRA_PYPI
ARG PYTHON_VERSION=3.12
ARG RUNTIME_PREREQS

# Never baked as ENV: the proxy is a build-time fact of one RUN.
ARG HTTPS_PROXY=
ARG http_proxy=
ARG https_proxy=
# The node's own value, not a second copy here that could silently win.
ARG no_proxy=

# The base image's apt mirror switch, reproduced for the builder: the amd node's
# containers cannot reach archive.ubuntu.com (its AAAA record hangs), so the
# aliyun mirror over HTTP comes first — no ca-certificates yet, so HTTPS would
# fail the handshake. This is what base/amd-rocm7.2.4 does, and it is repeated
# here because the builder is self-contained (FROM ubuntu:22.04) and never layers
# on the base image.
RUN sed -i \
        -e 's|http://archive.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
        -e 's|http://security.ubuntu.com/ubuntu|http://mirrors.aliyun.com/ubuntu|g' \
        -e 's|http://ports.ubuntu.com/ubuntu-ports|http://mirrors.aliyun.com/ubuntu-ports|g' \
        /etc/apt/sources.list /etc/apt/sources.list.d/*.sources 2>/dev/null || true \
    && apt-get -o Acquire::ForceIPv4=true update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl wget git \
        build-essential gcc g++ cmake \
        libgflags-dev libgoogle-glog-dev \
        libnuma1 libgfortran5 libdrm-amdgpu1 libdw1 libelf1 libpciaccess0 \
        pciutils \
    && rm -rf /var/lib/apt/lists/*

# python 3.12 from the deadsnakes PPA, the way Containerfile.builder and
# packaging/flagtree/nvidia-cuda do it. The amd row's matrix python_version is
# 3.12 and its torch pin is cp312, so the interpreter the wheel builds against
# has to be 3.12 — jammy's own python3.10 would produce a cp310 wheel that fails
# the probe's version assert. THE DEADSNAKES PPA IS WIRED BY HAND, NOT WITH
# add-apt-repository: that command resolves the PPA through Launchpad's REST API,
# and the CI runner's proxy answers the CONNECT to api.launchpad.net with 500; the
# key server and the package archive are reachable directly, so the key is
# fetched and the source line written by hand.
RUN curl -fsSL \
         "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
         | gpg --dearmor -o /etc/apt/trusted.gpg.d/deadsnakes.gpg \
    && echo "deb https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" \
         > /etc/apt/sources.list.d/deadsnakes.list \
    && apt-get -o Acquire::ForceIPv4=true update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/*

# The ROCm 7.2.4 jammy suite. The key and the pin mirror base/amd-rocm7.2.4, but
# the suite is jammy — the base image is noble and installs the 24.04 suite, whose
# .so files link GLIBC_2.38; this image must link at most 2.35, so it installs
# the 22.04 suite instead. The pin keeps radeon's build ahead of Ubuntu universe's
# older rocm-cmake/hipcc/rocminfo.
#
# The package set is the base image's lean set minus the debug/profiler tools this
# build never links (MIGraphX, rocm-gdb, rocprofiler-sdk, opencl stay omitted):
# the -dev packages carry the headers + unversioned .so symlinks the amd adaptor
# and torch's USE_ROCM headers reach. hipsolver/hipfft/miopen-hip are NOT optional
# even though the wheel does not link them: torch's own headers include theirs
# under USE_ROCM, and the flagcx torch wheel compiles against those headers.
#
# amdgpu-core lives in the graphics repo, not the rocm repo; the two deb lines are
# the base image's pair with jammy swapped in for noble.
RUN install -d /etc/apt/keyrings \
    && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/rocm.gpg \
    && printf '%s\n' \
        'deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/rocm/apt/7.2.4 jammy main' \
        'deb [arch=amd64 signed-by=/etc/apt/keyrings/rocm.gpg] https://repo.radeon.com/graphics/7.2.4/ubuntu jammy main' \
        > /etc/apt/sources.list.d/rocm.list \
    && printf '%s\n' \
        'Package: *' \
        'Pin: release o=repo.radeon.com' \
        'Pin-Priority: 600' \
        > /etc/apt/preferences.d/repo-radeon-pin-600 \
    && apt-get -o Acquire::ForceIPv4=true update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        amdgpu-core amd-smi-lib \
        rocm-smi-lib rocm-utils rocm-llvm rocm-device-libs rocm-cmake \
        hipcc rocminfo \
        hip-dev hipblas-dev hipblaslt-dev hipcub-dev hiprand-dev \
        hipfft-dev hipsolver-dev miopen-hip-dev \
        hipsparse-dev hipsparselt-dev hsa-rocr-dev rccl-dev \
        rocblas-dev rocfft-dev rocrand-dev rocsolver-dev \
        rocsparse-dev rocthrust-dev rocwmma-dev \
    && rm -rf /var/lib/apt/lists/*

# The row's SDK assert, checked here rather than as an unresolved symbol later.
RUN set -eux; \
    for path in ${BUILDER_ASSERT}; do \
        test -e "$path" || { echo "assert: $path is missing" >&2; exit 1; }; \
    done

# The same env the base image exports. DEVICE_HOME/CCL_HOME both point at
# /opt/rocm, and the profile.d capture hands the wheel build the LD_LIBRARY_PATH
# torch's import needs (libamdhip64.so and friends live under /opt/rocm/lib).
# rocm-core's postinst already made /opt/rocm -> /opt/rocm-7.2.4 via
# update-alternatives. Written as profile.d rather than ENV so it matches the
# base image's delivery and so wheel-build-in-container.sh's existing
# `source /etc/profile.d/vendor.sh` picks it up.
RUN printf '%s\n' \
      'export ROCM_PATH=/opt/rocm' \
      'export PATH=/opt/rocm/bin:$PATH' \
      'export LD_LIBRARY_PATH=/opt/rocm/lib' \
      'export HIP_VISIBLE_DEVICES=all' \
      > /etc/profile.d/vendor.sh

# Interpreter and torch, the two things the runtime image used to provide.
# /flagos is the same path the runtime/Containerfile.wheel use. prereqs+numpy
# from the general mirror, torch from the vendor index LAST so +rocm7.2 resolves
# there while its own deps resolve on the mirror.
ENV VIRTUAL_ENV=/flagos \
    PATH="/flagos/bin:${PATH}"
RUN set -eux; \
    python3.12 -m ensurepip --upgrade; \
    python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools; \
    python3.12 -m venv /flagos; \
    /flagos/bin/pip install --no-cache-dir --upgrade pip; \
    /flagos/bin/pip install --no-cache-dir --index-url "${EXTRA_PYPI}" \
        ${RUNTIME_PREREQS} ${NUMPY_PIN} wheel packaging; \
    for i in 1 2 3; do \
        PIP_INDEX_URL="${EXTRA_PYPI}" \
        PIP_EXTRA_INDEX_URL="${VENDOR_PYPI}" \
        PIP_TRUSTED_HOST=resource.flagos.net \
        /flagos/bin/pip install --no-cache-dir --pre "${TORCH_PIN}" && break; \
        echo "torch install attempt $i failed, retrying in 10s..."; sleep 10; \
    done

# The probe the wheel build stands in for: the same imports Containerfile.wheel
# asserts, plus the torch version that distinguishes this row. The vendor env is
# sourced first so `import torch` resolves libamdhip64.so from /opt/rocm/lib.
# The version is read through importlib.metadata: runtime_prereqs pins
# setuptools-scm>=8, which has no module-level __version__, and the ROCm torch
# wheel keeps the +rocm7.2 local segment in dist-info METADATA.
RUN set -eu; \
    if [ -f /etc/profile.d/vendor.sh ]; then . /etc/profile.d/vendor.sh; fi; \
    printf '%s\n' \
      'import importlib' \
      'import importlib.metadata' \
      'import os' \
      'import sys' \
      'import sysconfig' \
      '' \
      'for name in ("torch", "setuptools", "setuptools_scm", "wheel", "packaging",' \
      '             "torch.utils.cpp_extension"):' \
      '    importlib.import_module(name)' \
      '' \
      'header = os.path.join(sysconfig.get_paths()["include"], "Python.h")' \
      'assert os.path.exists(header), "no Python.h under %s" % header' \
      '' \
      'want_minor = int(os.environ["PYTHON_VERSION"].split(".", 1)[1])' \
      'assert sys.version_info[:2] == (3, want_minor), "the venv is %s, the row says %s" % (sys.version_info[:2], os.environ["PYTHON_VERSION"])' \
      '' \
      'import torch' \
      'want_torch = os.environ["TORCH_PIN"].split("==", 1)[1]' \
      'have_torch = importlib.metadata.version("torch")' \
      'assert have_torch == want_torch, "torch %s, the row pins %s" % (have_torch, want_torch)' \
      'print(">>> build env: %s, cp3%d, torch %s (metadata %s), setuptools_scm %s"' \
      '      % (sys.executable, want_minor, torch.__version__,' \
      '         have_torch,' \
      '         importlib.metadata.version("setuptools_scm")))' \
    | TORCH_DEVICE_BACKEND_AUTOLOAD=0 PYTHON_VERSION="${PYTHON_VERSION}" \
      TORCH_PIN="${TORCH_PIN}" /flagos/bin/python -
