#
# FlagCX wheels for one backend. One container, one backend.
#
# The build context is the repository root, not this directory:
#
#   key=hygon-dtk26.04
#   eval "$(python3 packaging/flagcx/deb-config.py --build-inputs "$key" --channel wheel)"
#   docker build \
#       --build-arg "BASE_IMAGE=$DEB_IMAGE_TAG" \
#       --build-arg "FLAGCX_REPO=https://github.com/flagos-ai/FlagCX.git" \
#       --build-arg "FLAGCX_REF=$FLAGCX_REF" \
#       --build-arg "BACKEND=$key" \
#       --build-arg "DEB_WHEEL_ASSERT=$DEB_WHEEL_ASSERT" \
#       --build-arg "DEB_WHEEL_ADAPTOR=$DEB_WHEEL_ADAPTOR" \
#       --build-arg "DEB_WHEEL_TORCH_BACKEND=$DEB_WHEEL_TORCH_BACKEND" \
#       --build-arg "DEB_WHEEL_VERSION_SUFFIX=$DEB_WHEEL_VERSION_SUFFIX" \
#       --build-arg "DEB_WHEEL_PYTHON_TAG=$DEB_WHEEL_PYTHON_TAG" \
#       --build-arg "DEB_WHEEL_MAKE_ENV=$DEB_WHEEL_MAKE_ENV" \
#       --build-arg "DEB_WHEEL_CUDA_PATH=$DEB_WHEEL_CUDA_PATH" \
#       -f packaging/flagcx/Containerfile.wheel -t "flagcx-wheel:$key" .
#
# packaging/flagcx/build-flagcx-wheel.sh is that recipe with the bookkeeping
# around it; it is written out here because it has to be reproducible by hand.
#
# The build is a single stage — the artifacts are read out of the image rather
# than copied to a later stage — so extraction is:
#
#   cid=$(docker create "flagcx-wheel:$key")
#   docker cp "$cid:/output/." ./dist/
#   docker rm "$cid"
#
# What the artifact is published under is its own name, and that name is the pin:
# `build-flagcx-wheel.sh --print-pin dist/flagcx-*.whl` reads one back and prints
# `flagcx==<public>+<local>`. PEP 440's `==` ignores the local part, so the row's
# version suffix at its head is the only thing keeping two vendors' builds of the
# same commit from colliding in one index.
#
# BASE_IMAGE is the backend's *runtime* image, where Containerfile.deb builds in
# the *base* image. plugin/torch/_build_config.py imports torch at build time to
# pick the extension classes, the torch suffix and the device rpaths, and only
# the runtime image's /flagos carries torch, setuptools_scm and a Python.h for
# the interpreter that will install the result. Build env == delivery env.
#
# Nothing in here reads backends.yaml.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG FLAGCX_REPO
ARG FLAGCX_REF
ARG BACKEND
ARG DEB_WHEEL_ASSERT
ARG DEB_WHEEL_ADAPTOR
ARG DEB_WHEEL_TORCH_BACKEND
ARG DEB_WHEEL_VERSION_SUFFIX
ARG DEB_WHEEL_PYTHON_TAG
ARG DEB_WHEEL_MAKE_ENV
ARG DEB_WHEEL_CUDA_PATH

# Scoped to the clone below and never set as image ENV: the proxy is a build-time
# fact of one RUN, and an image that remembers it is an image that leaks it.
ARG HTTPS_PROXY=

# git accepts either casing, and the runners export the lowercase pair — so the
# same fact is declared under both names rather than asking the call site for
# two spellings. The clone below reads the uppercase name, hence its fallback.
ARG http_proxy=
ARG https_proxy=

# Not baked here: which hosts must not be proxied is a fact about the node's
# network, and a second copy in this file silently overrode the node's own
# (measured on the 910c nodes, where the node's value is what took effect and
# the mirror went through the proxy anyway). The call site relays the node's
# value, and that is the only source.
ARG no_proxy=

# DEB_WHEEL_ASSERT is the list of files that proves the SDK is the one we think
# it is — checked here, in three seconds, rather than surfacing as an unresolved
# symbol after the build. The wheel line needs it for a second reason: the
# CUDA_PATH handed to the build is derived from the same registry row, so a
# container built from the wrong backend's runtime image is exactly the case
# where that path is plausible and wrong.
RUN set -eux; \
    for path in ${DEB_WHEEL_ASSERT}; do \
        test -e "$path" || { echo "assert: $path is missing" >&2; exit 1; }; \
    done

# torch's installed headers need two build-only headers that no runtime image
# ships: c10/util/Flags.h includes <gflags/gflags.h> (C10_USE_GFLAGS is defined
# outright in torch/headeronly/macros/cmake_macros.h:9) and c10/util/Logging.h
# reaches <glog/stl_logging.h>. Build-only — the compiler reads them and nothing
# at runtime does — so they belong here, not in the base or runtime image.
# Above the clone so a new FLAGCX_REF does not re-run it.
RUN set -eux; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        libgflags-dev libgoogle-glog-dev; \
    rm -rf /var/lib/apt/lists/*

# The venv's interpreter is not the base image's: uv installs its own CPython
# and seeds a relocatable venv from it (runtime/Containerfile), so an apt
# libpython3-dev of some neighbouring version is not what this python compiles
# against. The include-dir assertion is what catches that, and the tag assertion
# catches its mirror image: a wheel built by some other interpreter still
# installs, under a python tag for an ABI it was never compiled for.
#
# `packaging` is asserted because _build_config.py imports it at build time and
# it is NOT in configs.yaml runtime_prereqs. If this trips, the one-line fix is
# a runtime_prereqs entry in configs.yaml, not a change here.
#
# `torch.utils.cpp_extension` is asserted because that is the import the build
# actually dies on when the vendor environment is missing, and _build_config.py
# catches it as a bare ImportError: it warns, returns (None, None), and the build
# goes on to write a py3-none-any wheel with no extension in it. The failure the
# probe exists to prevent is silent, so the probe has to name it.
#
# The vendor environment is sourced first. DTK ships it in /etc/profile.d, which
# a login shell reads and `docker build` does not, so `import torch` fails on
# libgalaxyhip.so.5 with an empty LD_LIBRARY_PATH — measured in this image, and
# the reason the first hygon build produced a pure-Python wheel. The file guard
# is for backends whose runtime image has none.
#
# TORCH_DEVICE_BACKEND_AUTOLOAD=0 is what setup.py sets for itself before it
# imports anything: the probe must not do more than the build it stands in for.
#
# The probe reaches the interpreter on stdin rather than as a here-doc body: a
# Dockerfile here-doc is a BuildKit feature, and the classic builder — which the
# hygon runner falls back to, having no buildx — drops the body and commits a RUN
# that exits 0 having executed nothing. Measured there: a two-line probe printed
# nothing while the next step printed normally. The piped form behaves the same
# under either builder.
#
# The version is read through importlib.metadata, not `setuptools_scm.__version__`:
# runtime_prereqs pins setuptools-scm>=8, which has no module-level __version__, so
# reading one is an AttributeError that kills the probe before it says anything —
# the metax rows' first build ended exactly there.
RUN set -eu; \
    if [ -f /etc/profile.d/vendor.sh ]; then . /etc/profile.d/vendor.sh; fi; \
    printf '%s\n' \
      'import importlib' \
      'import importlib.metadata' \
      'import os' \
      'import sys' \
      'import sysconfig' \
      '' \
      'for name in ("torch", "setuptools", "setuptools_scm", "wheel", "packaging",' \
      '             "torch.utils.cpp_extension"):' \
      '    importlib.import_module(name)' \
      '' \
      'header = os.path.join(sysconfig.get_paths()["include"], "Python.h")' \
      'msg = "%s is missing: this interpreter ships no headers, so nothing can build here"' \
      'assert os.path.exists(header), msg % header' \
      '' \
      'tag = "cp3%d" % sys.version_info.minor' \
      'want = os.environ["DEB_WHEEL_PYTHON_TAG"]' \
      'assert tag == want, "the venv is %s, the registry row says %s" % (tag, want)' \
      '' \
      'import torch' \
      'print(">>> build env: %s, %s, torch %s, setuptools_scm %s"' \
      '      % (sys.executable, tag, torch.__version__,' \
      '         importlib.metadata.version("setuptools_scm")))' \
    | TORCH_DEVICE_BACKEND_AUTOLOAD=0 DEB_WHEEL_PYTHON_TAG="${DEB_WHEEL_PYTHON_TAG}" \
      /flagos/bin/python -

# No --depth 1 on the main repository: setuptools_scm derives the public version
# from the clone's tags and the distance to the nearest one, and a shallow clone
# has neither — the wheel would come out with setuptools_scm's no-tag fallback
# and nothing downstream would notice, since its own local part still looks
# right. The submodules are shallow instead — their history is nobody's business
# here, and they are not optional: the Makefile defaults JSON_INCLUDE_DIR to
# third-party/json/single_include (Makefile:248) and no base image ships
# nlohmann-json3-dev, so the submodule is the only source of that header.
#
# The submodules are fetched by their own loop rather than by
# --recurse-submodules, whose transfer runs in a child git the abort settings
# below do not reach: on hw115 a nlohmann/json fetch sat 12 minutes past its
# low-speed deadline with the log frozen, where a timeout makes it retryable.
#
# The main clone's low-speed abort is left nearly off: egress here is slow enough
# to trip curl's defaults on a healthy transfer (measured on hw115, whose apt
# mirror runs at 120 kB/s), and a slow clone is not a dead one. It still fires on
# a transfer that has genuinely stopped.
#
# --branch is not used: it takes a branch or a tag, and this line exists to build
# commits that are neither. The ref is resolved after the clone instead.
RUN export GIT_HTTP_CONNECT_TIMEOUT=15 \
           GIT_HTTP_LOW_SPEED_LIMIT=1 \
           GIT_HTTP_LOW_SPEED_TIME=300 && \
    export HTTPS_PROXY="${HTTPS_PROXY:-${https_proxy:-}}" && \
    git config --global http.version HTTP/1.1 && \
    for i in 1 2 3 4 5 6 7 8; do \
        git clone "${FLAGCX_REPO}" /flagcx && break; \
        echo ">>> flagcx clone attempt $i failed, retrying in 5s..."; \
        rm -rf /flagcx; sleep 5; \
    done && \
    test -d /flagcx/.git && \
    cd /flagcx && \
    for i in 1 2 3 4 5; do \
        timeout 300 git submodule update --init --recursive --depth 1 && break; \
        echo ">>> submodule fetch attempt $i failed, retrying in 5s..."; \
        sleep 5; \
    done && \
    test -f /flagcx/third-party/json/single_include/nlohmann/json.hpp

# The commit and the tag landscape are written out for the host to check: the
# wheel's own name is the only thing that carries the version, and it is written
# by a version scheme that reads this clone. A ref that is a branch name or a tag
# resolves by itself; a 40-hex SHA has to be fetched before it can be checked out
# (`git clone --branch <sha>` refuses it outright — Containerfile.deb:128 uses
# that idiom and cannot use it here), and when the ref is one, the checkout is
# asserted rather than assumed: a silent fallback to the default branch would
# otherwise produce a well-formed wheel of the wrong commit.
RUN set -eux; \
    cd /flagcx; \
    if ! git checkout -q "${FLAGCX_REF}" 2>/dev/null; then \
        git fetch origin "${FLAGCX_REF}"; \
        git checkout -q FETCH_HEAD; \
    fi; \
    sha="$(printf '%s' "${FLAGCX_REF}" | tr '[:upper:]' '[:lower:]')"; \
    if printf '%s' "$sha" | grep -Eq '^[0-9a-f]{40}$'; then \
        test "$(git rev-parse HEAD)" = "$sha" \
            || { echo "assert: checked out $(git rev-parse HEAD), asked for $sha" >&2; exit 1; }; \
    fi; \
    test "$(git tag -l 'v*' | wc -l)" -gt 0 \
        || { echo "assert: the clone carries no v* tag, so the version cannot be derived" >&2; exit 1; }; \
    mkdir -p /output; \
    git rev-parse HEAD > /output/commit.txt; \
    git describe --tags --always > /output/scm-describe.txt

WORKDIR /flagcx

# The ARGs are re-passed as environment: build args are not environment
# variables, and setup.py reads every one of these out of the environment.
#
# A runner that exports SETUPTOOLS_SCM_PRETEND_VERSION (vllm-plugin-wheel.yml
# does, for its own wheel) would otherwise override the tag-derived version here
# and produce a wheel whose name has nothing to do with the commit.
#
# FLAGCX_ADAPTOR is given rather than detected: the adaptor is a property of the
# registry row, not of the container's PATH, and _build_config.py's fallback also
# scans USE_* variables that this build does not set.
#
# CUDA_PATH is read by the du adaptor at build-config time and is not a second
# spelling of anything make sees: du.mk's `DEVICE_HOME ?= $(CUDA_PATH)` ladder
# (du.mk:4,14) is unreachable for hygon — backends.yaml pins both names — while
# _build_config.py:284 consults no ladder at all, reading CUDA_PATH or CUDA_HOME
# and then falling back to /usr/local/cuda, which DTK does not have. It is
# derived from the row's DEVICE_HOME, so it is the same fact, not a new one.
# Rows whose adaptor reads a literal path (metax: /opt/maca) derive nothing, and
# an empty CUDA_PATH is inert for them: it is absent from metax.mk and falsy to
# _build_config.py's `or`.
#
# --no-build-isolation: pyproject.toml requires torch, so isolation would go to
# an index for it. --no-deps: setup.py declares no install_requires and
# pyproject.toml no dependencies, so this turns "nothing was pulled in" into a
# failure instead of a silent extra dependency inside the wheel.
#
# The vendor environment is sourced for the same reason the probe sources it:
# setup.py imports torch through _build_config.py, and make needs the SDK's
# compiler, headers and libraries on PATH/LD_LIBRARY_PATH. Both live in
# /etc/profile.d, which a login shell reads and this one does not. Sourcing comes
# first so that the CUDA_PATH exported below wins over anything the file sets.
RUN set -eux; \
    if [ -f /etc/profile.d/vendor.sh ]; then . /etc/profile.d/vendor.sh; fi; \
    unset SETUPTOOLS_SCM_PRETEND_VERSION SETUPTOOLS_SCM_PRETEND_VERSION_FOR_FLAGCX; \
    export FLAGCX_ADAPTOR="${DEB_WHEEL_ADAPTOR}" \
           FLAGCX_TORCH_BACKEND="${DEB_WHEEL_TORCH_BACKEND}" \
           FLAGCX_VERSION_SUFFIX="${DEB_WHEEL_VERSION_SUFFIX}" \
           CUDA_PATH="${DEB_WHEEL_CUDA_PATH}" \
           ${DEB_WHEEL_MAKE_ENV}; \
    /flagos/bin/python -m pip wheel --no-build-isolation --no-deps --no-cache-dir -w /output .; \
    ls -la /output

# Exactly one wheel, asserted by the glob — and by its existence, since an
# unmatched pattern stays literal in /bin/sh and would count as one. A second
# wheel means something else in the tree is installable, and the pin cannot tell
# them apart: it names a version, not a file.
RUN set -eux; \
    set -- /output/flagcx-*.whl; \
    test "$#" -eq 1 -a -e "$1" \
        || { ls -1 /output >&2; echo "assert: $# wheels in /output, expected exactly 1" >&2; exit 1; }; \
    ls -1 /output/flagcx-*.whl
