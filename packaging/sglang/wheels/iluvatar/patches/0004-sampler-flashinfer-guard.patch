# iluvatar: same class as the vision/fp8 guards — no flashinfer build exists
# for corex while is_cuda() is True, so this module-level import under
# `if is_cuda` aborts the sampler import (reached from model_runner's
# create_sampler). metax does not need this one: its runtime installs a vendor
# flashinfer, so the import resolves there.
#
# Guarding only the import (rather than providing a stand-in) is deliberate:
# flashinfer must stay genuinely unimportable, because
# `_sampling_backend_default` (arg_groups/overrides.py) picks the "flashinfer"
# sampling backend iff is_flashinfer_available(). A stand-in would flip that to
# True and silently route sampling into a no-op stub; with the import guarded
# the backend defaults to "pytorch" and the symbols below are never called.
# They are still bound (to None) so a stray call fails loudly instead of
# raising NameError.
--- a/python/sglang/srt/layers/sampler.py
+++ b/python/sglang/srt/layers/sampler.py
@@ -28,10 +28,16 @@
 )

 if is_cuda():
-    from flashinfer.sampling import (
-        min_p_sampling_from_probs,
-        top_k_top_p_sampling_from_probs,
-    )
+    try:
+        from flashinfer.sampling import (
+            min_p_sampling_from_probs,
+            top_k_top_p_sampling_from_probs,
+        )
+    except ImportError:
+        # iluvatar: no flashinfer build for corex; the sampling backend
+        # defaults to pytorch, so these are never called.
+        min_p_sampling_from_probs = None
+        top_k_top_p_sampling_from_probs = None
     from sgl_kernel import (
         top_k_renorm_prob,
         top_p_renorm_prob,
