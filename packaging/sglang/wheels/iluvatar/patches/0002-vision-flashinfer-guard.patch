#
# iluvatar: no flashinfer build exists for corex, but is_cuda() is True
# (corex torch is CUDA-alias and reports torch.version.cuda), so this
# module-level import under `if _is_cuda` fires on every process that touches
# vision.py. The symbol is only referenced behind a hasattr check. Same failure
# class as metax (wheels/metax/patches 0002) — kept as a per-vendor copy
# because build-and-repack.sh only reads wheels/<vendor>/patches.
--- a/python/sglang/srt/layers/attention/vision.py
+++ b/python/sglang/srt/layers/attention/vision.py
@@ -46,7 +46,12 @@
 _is_xpu = is_xpu()

 if _is_cuda:
-    from flashinfer.prefill import cudnn_batch_prefill_with_kv_cache
+    try:
+        from flashinfer.prefill import cudnn_batch_prefill_with_kv_cache
+    except ImportError:
+        # iluvatar has no flashinfer at all; the symbol is only referenced
+        # behind a hasattr check.
+        cudnn_batch_prefill_with_kv_cache = None

     from sglang.kernels.ops.attention.flash_attention import flash_attn_varlen_func

