# iluvatar: corex torch is CUDA-alias but ships no nvcc, so the clamp_position
# JIT load (sglang.kernels.ops.attention.clamp_position) fails on every
# ForwardBatch.init_new. Fall back to the torch-native compute instead of
# crashing. Same failure class as metax (wheels/metax/patches 0001) — kept as a
# per-vendor copy because build-and-repack.sh only reads wheels/<vendor>/patches.
# Applied by build-and-repack.sh before the wheel build.
--- a/python/sglang/kernels/ops/attention/clamp_position.py
+++ b/python/sglang/kernels/ops/attention/clamp_position.py
@@ -29,7 +29,12 @@

     Supported dtypes: torch.int32, torch.int64.
     """
-    dst = torch.empty_like(seq_lens)
-    module = _jit_clamp_position_module(seq_lens.dtype)
-    module.clamp_position(dst, seq_lens)
-    return dst
+    try:
+        dst = torch.empty_like(seq_lens)
+        module = _jit_clamp_position_module(seq_lens.dtype)
+        module.clamp_position(dst, seq_lens)
+        return dst
+    except (RuntimeError, FileNotFoundError):
+        # iluvatar: CUDA-alias torch without nvcc makes the JIT load fail;
+        # fall back to a torch-native compute.
+        return torch.clamp(seq_lens - 1, min=0)
