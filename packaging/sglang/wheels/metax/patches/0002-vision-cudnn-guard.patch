# metax (ADR 5.5): the vendor flashinfer build strips the cudnn batch
# prefill symbols, so the module-level import must not abort the import
# chain. The symbol is only referenced behind a hasattr check.
--- a/python/sglang/srt/layers/attention/vision.py
+++ b/python/sglang/srt/layers/attention/vision.py
@@ -46,7 +46,12 @@
 _is_xpu = is_xpu()
 
 if _is_cuda:
-    from flashinfer.prefill import cudnn_batch_prefill_with_kv_cache
+    try:
+        from flashinfer.prefill import cudnn_batch_prefill_with_kv_cache
+    except ImportError:
+        # metax flashinfer build strips cudnn_batch_prefill (no cudnn);
+        # only referenced behind a hasattr check.
+        cudnn_batch_prefill_with_kv_cache = None
 
     from sglang.kernels.ops.attention.flash_attention import flash_attn_varlen_func
 
