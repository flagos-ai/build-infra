# metax (ADR 5.5): CUDA-alias torch without nvcc makes the clamp_position
# JIT load fail. Fall back to a torch-native compute instead of crashing.
# Applied by build-and-repack.sh before the wheel build.
--- a/python/sglang/kernels/ops/attention/clamp_position.py
+++ b/python/sglang/kernels/ops/attention/clamp_position.py
@@ -29,7 +29,12 @@
 
     Supported dtypes: torch.int32, torch.int64.
     """
-    dst = torch.empty_like(seq_lens)
-    module = _jit_clamp_position_module(seq_lens.dtype)
-    module.clamp_position(dst, seq_lens)
-    return dst
+    try:
+        dst = torch.empty_like(seq_lens)
+        module = _jit_clamp_position_module(seq_lens.dtype)
+        module.clamp_position(dst, seq_lens)
+        return dst
+    except (RuntimeError, FileNotFoundError):
+        # metax: CUDA-alias torch without nvcc makes the JIT load fail;
+        # fall back to a torch-native compute (ADR 5.5).
+        return torch.clamp(seq_lens - 1, min=0)
