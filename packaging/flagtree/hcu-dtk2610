# Build a FlagTree hcu wheel for the hygon-dtk26.10 line on Ubuntu 22.04.
# The 26.10 runtime pins python 3.12 (torch 2.13.0 is cp312-only), so this is
# the hcu builder rebased from the 26.04 line's system 3.10 to a deadsnakes
# 3.12 -- the wheel has to wear cp312 or the runtime's `pip install flagtree==`
# cannot resolve it. The base is still 22.04: DTK 26.10 ships a native
# Ubuntu22.04 tarball, and the wheel's libtriton.so must load on the 24.04
# runtime, which is the direction glibc compatibility runs in.
#   docker build --target builder -t flagtree-builder-hcu-dtk2610:ci -f hcu-dtk2610 .
#   docker build -t flagtree-hcu-dtk2610:0.7.0 -f hcu-dtk2610 .

ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

# Proxy is consumed during build only -- an ARG is not persisted in the image.
# no_proxy is declared too: an undeclared ARG of that name is not inherited, and
# it is the one that keeps the deps download below off the tunnel.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The prebuilt inputs, staged on our own filestore: ks3 answers the CI proxy
# with 500. The LLVM keeps the vendor's filename and its own top-level name,
# because that name IS hcu.py's cache key -- FlagTree re-downloads a cache it
# does not recognize by that exact name.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG LLVM_TARBALL=hcu-llvm22-b0ca808-glibc2.35-glibcxx3.4.30-ubuntu-x86_64_v0.5.0.tar.gz
ARG LLVM_DIR=hcu-llvm22-b0ca808-glibc2.35-glibcxx3.4.30-ubuntu-x86_64
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz

# DTK 26.10, the Ubuntu22.04 build: it is byte-identical to the 24.04-named
# tarball the base image takes (same 3653732295-byte payload), and this stage
# is ubuntu:22.04, so it installs the SDK under the name that matches its own
# distro. The install mirrors the flagcx builder-vendor-hygon twin.
ARG FILE_STORE=https://resource.flagos.net/repository/flagos-filestore/hygon
ARG SDK_PACKAGE=DTK-26.10-Ubuntu22.04-x86_64.tar.gz

ENV DEBIAN_FRONTEND=noninteractive

# The hcu build reads HIP headers from third_party/hcu/backend/include/hip/**,
# tracked in git, and DTK is only needed at launch time (driver.c dlopens
# libgalaxyhip.so lazily) -- the 26.04 builder staged no SDK and still built.
# The 26.10 line differs in the interpreter: torch 2.13.0 is cp312-only, hence
# the deadsnakes PPA (wired by hand, same as enflame: add-apt-repository
# resolves through Launchpad's REST API and the runner's proxy answers that with
# 500). The DTK install is not what compiles the wheel, but the runtime image
# carries it, so this stage stages the same toolchain to build against.

# The marker is written last, and is the point of the first line: on top of a
# published builder the earlier work is already in the image but the instruction
# still runs, so without the guard every warm build would reinstall the same
# packages and re-fetch the same ~5 GB of tarballs.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl \
        git wget \
    && curl -fsSL \
         "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
         | gpg --dearmor -o /etc/apt/trusted.gpg.d/deadsnakes.gpg \
    && echo "deb https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" \
         > /etc/apt/sources.list.d/deadsnakes.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build binutils \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        libncurses5-dev libncursesw5-dev libgdbm-dev libnss3-dev \
        libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
        libdb5.3-dev libbz2-dev libexpat1-dev liblzma-dev \
        libnuma1 libgfortran5 libdrm-amdgpu1 libdw1 libelf1 libpciaccess0 \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m ensurepip --upgrade \
    && python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools \
    && mkdir -p /root/.flagtree/hcu /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           wget -q --tries=3 --timeout=60 "${DEPS_BASE}/${f}" -O "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && for i in 1 2 3 4 5; do \
         wget -q --tries=3 --timeout=300 "${FILE_STORE}/${SDK_PACKAGE}" -O "${SDK_PACKAGE}" && break; \
         echo ">>> download ${SDK_PACKAGE} attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C /root/.flagtree/hcu \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && tar -xzf "${SDK_PACKAGE}" -C /opt \
    && ln -sf /opt/dtk-26.10 /opt/dtk \
    && rm -f /tmp/*.tar.gz \
    && test -f "/root/.flagtree/hcu/${LLVM_DIR}/bin/FileCheck" \
    && test -f "/root/.flagtree/hcu/${LLVM_DIR}/lib/cmake/mlir/MLIRConfig.cmake" \
    && test -f "/root/.flagtree/hcu/${LLVM_DIR}/lib/cmake/lld/LLDConfig.cmake" \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && test -d /root/.triton/nvidia/cudart \
    && test -d /root/.triton/nvidia/cupti \
    && test -f /opt/dtk/env.sh \
    && touch /opt/flagtree-build-env.ready

# The two find_package() contracts are inside the staged LLVM, not apt: CMakeLists
# defaults MLIR_DIR to ${LLVM_LIBRARY_DIR}/cmake/mlir and LLD_DIR to the sibling
# cmake/lld, and hcu's own CMakeLists find_package()s LLD against the latter -- so
# no lld-14 package and no explicit -DLLD_DIR are needed.

# `--strip-components=1` makes the triton toolkits a cache: that tarball is rooted
# at `.triton/`, and unstripped it lands one level below what FlagTree reads, which
# then re-fetches json and the CUDA redists over the network.

# LLVM_SYSPATH is deliberately NOT set: hcu.py's cache entry short-circuits on it
# (`pre_hook=check_env("LLVM_SYSPATH")`), so setting it would bypass the staged
# LLVM and send the build to the vendor's ks3 bucket instead.

FROM builder AS flagtree

# Stage-scoped, so every arg the wheel build reads is declared again. BuildKit
# inherits a parent stage's ARGs into a `FROM parent` child and the legacy
# builder does not, so an ARG declared only above is empty on half the runners.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# FlagTree ref, the single version knob; the backend is selected at build time via
# FLAGTREE_BACKEND, not by source. The default is the release configs.yaml pins
# for hygon-dtk26.10 -- a client installs this wheel's version, so the two must
# not drift. A daily run overrides it.
ARG FLAGTREE_VERSION=0.7.0+hcu3.6

# Wheel version, defaulting to the ref so one arg drives both. FlagTree appends a
# dirty "+git<sha>" unless it holds the vendor's FLAGTREE_PYPI_KEY or finds no
# .git dir, so the build removes .git before `pip wheel`.
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=

# No pybind11 pin: hcu.py ships no internals table and no prebuilt .so is an ABI
# counterparty -- every binding in this wheel is compiled here from one pybind11,
# so there is nothing for a pin to agree with. The gate asserts what that leaves
# unstated: that libtriton.so and the build's pybind11 agree on the ABI.
ARG MAX_JOBS=32

# THE SHA IS READ BEFORE .git GOES, AND BOTH BEFORE `pip wheel`: the version has
# to come out clean, so .git must not exist when setup.py asks, while the commit
# id is worth keeping, so it goes into a setup.cfg that setuptools merges into
# setup() on its own. FlagTree ships no setup.cfg of its own, so its absence is
# asserted rather than assumed.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && cd /opt/flagtree \
    && python3.12 -m pip install --no-cache-dir -r python/requirements.txt \
    && export FLAGTREE_BACKEND=hcu \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export MAX_JOBS="${MAX_JOBS}" \
    && rm -rf /opt/flagtree/.git \
    && for i in 1 2 3 4 5; do \
         python3.12 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# printf to a file, not `python - <<'PY'`: on Docker's legacy builder a heredoc
# never reaches python's stdin and the step passes having asserted nothing.
# The backend package it ships is the proof the right backend was built, and the
# two .so files agreeing on pybind11 internals is the invariant the missing pin
# would otherwise carry.
RUN printf '%s\n' \
      'import glob, os, re, subprocess, sys, tempfile, zipfile' \
      '' \
      'whl = glob.glob("/wheels/*.whl")[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if "git" in ver:' \
      '    print("FAIL: dirty wheel version " + ver + " (expected clean, no git-sha suffix)")' \
      '    sys.exit(1)' \
      'if "cp312" not in name:' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp312)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name + " version " + ver)' \
      '' \
      'd = tempfile.mkdtemp()' \
      'zf = zipfile.ZipFile(whl)' \
      'zf.extractall(d)' \
      'for p in ("triton/backends/hcu/__init__.py", "triton/backends/hcu/compiler.py"):' \
      '    if not os.path.exists(os.path.join(d, p)):' \
      '        print("FAIL: " + name + " ships no " + p + " (wrong FLAGTREE_BACKEND?)")' \
      '        sys.exit(1)' \
      'print("OK: wheel ships the hcu backend package")' \
      '' \
      'so = os.path.join(d, "triton", "_C", "libtriton.so")' \
      'if not os.path.exists(so):' \
      '    print("FAIL: no triton/_C/libtriton.so in " + name)' \
      '    sys.exit(1)' \
      'syms = subprocess.check_output(["objdump", "-T", so], text=True)' \
      'forbidden = ["GLIBC_2.38", "GLIBCXX_3.4.31", "GLIBCXX_3.4.32", "__isoc23_"]' \
      'hits = [f for f in forbidden if f in syms]' \
      'if hits:' \
      '    print("FAIL: 22.04-incompatible symbols in libtriton.so: " + str(hits))' \
      '    sys.exit(1)' \
      'maxglibc = max(set(re.findall(r"GLIBC_[0-9.]+", syms)), key=lambda v: [int(x) for x in v[6:].split(".")])' \
      'print("OK: libtriton.so is 22.04-clean (max " + maxglibc + ", no forbidden symbols)")' \
      '' \
      'import pybind11' \
      'hdr = os.path.join(pybind11.get_include(), "pybind11", "detail", "internals.h")' \
      'm = re.search(r"#\s*define\s+PYBIND11_INTERNALS_VERSION\s+(\d+)", open(hdr).read())' \
      'if not m:' \
      '    print("FAIL: no PYBIND11_INTERNALS_VERSION in " + hdr)' \
      '    sys.exit(1)' \
      'want = m.group(1).encode()' \
      'tagged = lambda p: sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", open(p, "rb").read())))' \
      'sos = sorted(glob.glob(d + "/triton/_C/*.so"))' \
      'bad = {os.path.basename(p): tagged(p) for p in sos if tagged(p) and tagged(p) != [want]}' \
      'if tagged(so) != [want] or bad:' \
      '    print("FAIL: pybind11 internals " + str(tagged(so)) + " in libtriton.so, " + str(bad) + " elsewhere; the build installed pybind11 " + pybind11.__version__ + " which provides v" + want.decode())' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so and every tagged .so in _C carry pybind11 internals v" + want.decode() + ", matching the build pybind11 " + pybind11.__version__)' \
    > /tmp/gate.py \
    && python3.12 /tmp/gate.py

# Smoke test: install the freshly built wheel, import it, and assert the two
# things the version pin and the setup.cfg carrier are for. No DTK env is sourced
# here on purpose: the wheel must import without it, as it does on the runtime
# image before the first launch.
RUN python3.12 -m pip install --no-cache-dir /wheels/*.whl \
    && python3.12 -c "\
import importlib.metadata as md, triton;\
from triton.backends import backends;\
print('OK', md.version('${FLAGTREE_WHEEL_NAME}'), 'triton', triton.__version__, 'backends', sorted(backends));\
assert 'hcu' in backends, sorted(backends);\
urls = md.metadata('${FLAGTREE_WHEEL_NAME}').get_all('Project-URL') or [];\
print('OK', [u for u in urls if u.startswith('Source-Commit')]);\
assert any(u.startswith('Source-Commit, https://github.com/flagos-ai/flagtree/commit/') for u in urls), urls;\
assert md.version('${FLAGTREE_WHEEL_NAME}') == '${FLAGTREE_WHEEL_VERSION}', md.version('${FLAGTREE_WHEEL_NAME}');\
assert 'git' not in md.version('${FLAGTREE_WHEEL_NAME}'), md.version('${FLAGTREE_WHEEL_NAME}')"
