# FlagTree wheel for the ascend-cann9.0.0 backend (Triton 3.5 / aarch64 / cp311),
# from source -> /wheels. Named after the backend, not the FlagTree line.
# Build: docker build -t flagtree-ascend-cann9.0.0:0.7.0 -f ascend-cann9.0.0 .
# Extract: id=$(docker create flagtree-ascend-cann9.0.0:0.7.0); docker cp $id:/wheels ./wheels

# TWO STAGES, ONE FILE, the shape metax / iluvatar / sunrise already have. The
# cold base is the backend's RUNTIME image, not a bare ubuntu -- see the README's
# ascend section for why. BUILDER_IMAGE is also the cold/warm knob.
ARG BUILDER_IMAGE=harbor.baai.ac.cn/flagos-runtime/flagos-runtime-ascend-cann9.0.0:2.3.0
FROM ${BUILDER_IMAGE} AS builder

# The runner's proxy, relayed as build args like every other builder. git, curl
# and pip all read these on their own -- the build never probes, never guesses,
# and never decides for the runner which endpoints are reachable directly.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The two prebuilt inputs, staged on our own filestore: ks3 answers the CI proxy
# with 500 and is in no runner's no_proxy. The names are upstream's -- FlagTree
# declares them in python/setup_tools/utils/ascend.py and setup_helper.py, and
# re-downloads what it does not recognize.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG LLVM_TARBALL=llvm-7d5de303-ubuntu-aarch64-python311-compat_v0.6.0.tar.gz
ARG LLVM_DIR=llvm-7d5de303-ubuntu-aarch64-python311-compat
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.5.x-linux-aarch64.tar.gz

# bash, not the image's dash: the CANN environment reaches non-interactive shells
# only through BASH_ENV + bash.
SHELL ["/bin/bash", "-c"]

# The marker is written last: on top of a published builder every line below is
# already in the image, and the guard is what skips it. No --noproxy carve-out:
# curl reads the relayed proxy args, and this bucket being reached directly is the
# CANN runners' no_proxy to say -- not a value to invent here.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    mkdir -p /root/.flagtree/ascend /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           curl -fsSL --retry 3 --retry-delay 5 --connect-timeout 30 \
             "${DEPS_BASE}/${f}" -o "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C /root/.flagtree/ascend \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -x "/root/.flagtree/ascend/${LLVM_DIR}/bin/clang" \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && touch /opt/flagtree-build-env.ready

FROM builder AS flagtree

# Stage-scoped, so every arg this stage reads is declared again: ARGs do not carry
# across FROM, while the stage's filesystem, ENV and SHELL do. The proxy args are
# here because this stage clones the source and pip-installs.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# FlagTree ref to build: branch, tag or sha. Pin a sha for a release. The default
# is the branch this CANN line's fixes land on, not upstream's main.
ARG FLAGTREE_VERSION=triton_v3.5.x
# OUR label for the FlagTree line, not the vendor's. It tracks the branch: this
# one is the 3.5 line, which upstream labels 0.7.0, and configs.yaml pins
# 0.7.0+ascend3.5. The UTC date is what marks a rebuild.
ARG FLAGTREE_BASE_VERSION=0.7.0+ascend3.5
# blank = "<FLAGTREE_BASE_VERSION>.<UTC date>"
ARG FLAGTREE_WHEEL_VERSION=
# The distribution name; the daily line would set its own, this line's default
# keeps publishing plain `flagtree`.
ARG FLAGTREE_WHEEL_NAME=flagtree
# The staged LLVM supplies the compiler, so its directory name reaches this stage
# through PATH. Declared again for the same reason as the proxy args.
ARG LLVM_DIR=llvm-7d5de303-ubuntu-aarch64-python311-compat
# A wrong BUILDER_IMAGE must fail here, not pair the wheel with another bishengir.
ARG CANN_VERSION=9.0.0
# ABI contract with the runtime (3.0.3 = internals v11): an unpinned install pulls
# 3.1.x, which imports fine and breaks at kernel-compile time. _VERSION, since ARG
# splits on the first '='. PYBIND11 is the runtime venv's own version; nanobind is
# a contract with the prebuilt LLVM instead, which asks for 2.4 and rejects 3.x.
ARG PYBIND11_VERSION=3.0.3
ARG NANOBIND_VERSION=2.4.0
# pypi.org is unreachable from the runners.
ARG EXTRA_PYPI=https://mirrors.aliyun.com/pypi/simple
# AscendNPU-IR is a whole MLIR project; upstream's delivery uses 32.
ARG MAX_JOBS=32

# FETCH_HEAD takes branch/tag/sha alike. /opt/flagtree-src, never the vendor /opt/flagtree.
RUN export GIT_HTTP_CONNECT_TIMEOUT=15 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 \
    && git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         rm -rf /opt/flagtree-src && git init -q /opt/flagtree-src \
           && git -C /opt/flagtree-src remote add origin https://github.com/flagos-ai/flagtree \
           && git -C /opt/flagtree-src fetch --depth 1 origin "${FLAGTREE_VERSION}" \
           && git -C /opt/flagtree-src checkout -q FETCH_HEAD && break; \
         echo ">>> flagtree fetch attempt $i failed, retrying in 5s..."; \
         sleep 5; \
       done \
    && test -d /opt/flagtree-src/.git \
    && git -C /opt/flagtree-src --no-pager log -1 --format='>>> flagtree source: %H %s'

# PYTHONPATH is dropped: zz-flagos.sh puts the VENDOR flagtree on it in every bash.
# TRITON_APPEND_CMAKE_ARGS force-includes <cstdint>: FlagPrism (on by default here)
# uses uint64_t with only <variant>/<vector> in scope, so all of its units fail.
# The sha is read BEFORE .git goes (the version must come out clean) and travels
# in a setup.cfg setuptools merges into setup() on its own -- see the README.
RUN unset PYTHONPATH \
    && cd /opt/flagtree-src \
    && sha8="$(git rev-parse --short=8 HEAD)" \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree-src/setup.cfg \
    && PIP_INDEX_URL="${EXTRA_PYPI}" pip install --no-cache-dir -r python/requirements.txt \
    && pip install --no-cache-dir "pybind11==${PYBIND11_VERSION}" "nanobind==${NANOBIND_VERSION}" \
    && _ver="${FLAGTREE_WHEEL_VERSION:-${FLAGTREE_BASE_VERSION}.$(date -u +%Y%m%d)}" \
    && echo ">>> wheel version: ${_ver}" \
    && export FLAGTREE_BACKEND=ascend FLAGTREE_WHEEL_VERSION="${_ver}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export TRITON_APPEND_CMAKE_ARGS='-DCMAKE_CXX_FLAGS="-include cstdint"' \
    && export PATH="/root/.flagtree/ascend/${LLVM_DIR}/bin:${PATH}" \
    && clang --version \
    && rm -rf /opt/flagtree-src/.git \
    && for i in 1 2 3; do \
         MAX_JOBS="${MAX_JOBS}" pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# A COPYed gate, not a heredoc: the CANN nodes run Docker's legacy builder.
# PYTHONPATH is dropped here too, so the internals check reads pybind11 out of the
# interpreter the build installed it into and not the vendor flagtree's tree.
COPY verify_ascend_wheel.py /tmp/
RUN CANN_VERSION="${CANN_VERSION}" PYTHONPATH= python3 /tmp/verify_ascend_wheel.py

# Import from a directory of its own, so a passing import cannot be the vendor's.
# Version from the file name, not from a known distribution prefix: the daily
# line stamps a distribution name of its own.
RUN whl="$(basename /wheels/*.whl)" \
    && ver="${whl%%-cp311-*}" && ver="${ver##*-}" \
    && rm -rf /opt/wheel-test \
    && pip install --no-cache-dir --no-deps --target /opt/wheel-test /wheels/*.whl \
    && PYTHONPATH=/opt/wheel-test WHEEL_VER="${ver}" WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" python3 -c "\
import importlib.metadata as md, os, triton;\
from triton.backends import backends;\
ver = os.environ['WHEEL_VER'];\
name = os.environ['WHEEL_NAME'];\
assert triton.__file__.startswith('/opt/wheel-test'), triton.__file__;\
assert 'ascend' in backends, sorted(backends);\
assert md.version(name) == ver, (md.version(name), ver);\
print('OK', name, md.version(name), 'triton', triton.__version__, 'backends', sorted(backends))"
