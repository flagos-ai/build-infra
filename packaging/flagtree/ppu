# Build a FlagTree ppu (T-Head PPU) wheel on Ubuntu 24.04. Not for the glibc
# floor -- the vendor's 0.7.0+ppu3.6 wheel is a 24.04 build itself (its
# libtriton.so carries GCC 13.3.0 and needs GLIBC_2.38) -- but for provenance: it
# carries no Source-Commit at all. No PPU SDK is needed: third_party/ppu compiles
# against libc/std headers, and $PPU_HOME / libhggc.so / ppu-llc are resolved
# lazily at kernel-compile and launch time.
# Build = `docker build -t flagtree-ppu:0.7.0+ppu3.6 -f ppu .` then `docker
# create` + `docker cp $id:/wheels .`.

ARG BUILDER_IMAGE=ubuntu:24.04
FROM ${BUILDER_IMAGE} AS builder

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# LLVM f6ded0be is what cmake/llvm-hash.txt names, and the tarball carries the
# two find_package() targets third_party/amd asks for -- MLIR at
# ${LLVM_LIBRARY_DIR}/cmake/mlir and LLD at the sibling cmake/lld -- plus the
# lld/Common/Driver.h triton_amd.cc includes. ppu shares the default+extend
# codegen group with amd and nvidia, so a ppu build compiles amd and has to
# satisfy that find_package(). Mirrored on our filestore: the Azure blob is the
# one link that stalls on a CN runner.
ARG FILESTORE=https://resource.flagos.net/repository/flagos-filestore
ARG LLVM_HASH=f6ded0be
ARG LLVM_TARBALL=llvm-${LLVM_HASH}-ubuntu-x64.tar.gz
ARG LLVM_DIR=/opt/llvm-${LLVM_HASH}-ubuntu-x64
# nvidia is in the codegen set too, so setup.py copies its CUDA redists out of
# these caches; the tarball also supplies the nlohmann/json.hpp the proton and
# PPU headers need. Staged here rather than fetched from developer.download.nvidia.com.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz
# pip has to come off a mirror: a bare ubuntu has no index configured, and
# pypi.org is unreachable from the ppu node by both routes (no proxy in its
# runner environment, and direct egress times out). Same index the runtime image
# sets for itself.
ARG EXTRA_PYPI=https://mirrors.cloud.tencent.com/pypi/simple

# LLVM_SYSPATH alone is the contract: get_thirdparty_packages() reads it, skips
# both the download and its own version.txt check, and derives the include and
# library flags from it. LLVM_INCLUDE_DIRS / LLVM_LIBRARY_DIR are deliberately not
# set as well -- they add nothing once the syspath is there, and any of the three
# trips LLVMDetector into aborting the build if an mlir wheel is ever installed
# beside them. ENV rather than ARG because stage 2 is where it is consumed.
ENV LLVM_SYSPATH=${LLVM_DIR}
ENV DEBIAN_FRONTEND=noninteractive

# python 3.12 is the distro's own on 24.04 -- no PPA, unlike the 22.04 stages.
# It goes into a venv rather than the system interpreter because 24.04's python
# is PEP 668 externally-managed and every install below is a build tool, not a
# system package. The venv's bin comes first so `python3.12` in stage 2 is this
# one; the wheels it produces are cp312 either way.
#
# The marker is written last, so a build that died halfway is retried rather
# than trusted, and a published builder turns this whole step into a no-op.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl wget git \
        build-essential cmake ninja-build binutils \
        zlib1g-dev libxml2-dev nlohmann-json3-dev \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m venv /opt/build-venv \
    && /opt/build-venv/bin/pip install --no-cache-dir --index-url "${EXTRA_PYPI}" --upgrade pip wheel setuptools \
    && mkdir -p "${LLVM_DIR}" /root/.triton \
    && cd /tmp \
    && for i in 1 2 3 4 5; do \
         wget -q --tries=3 --timeout=120 "${FILESTORE}/llvm/${LLVM_TARBALL}" -O "${LLVM_TARBALL}" && break; \
         echo ">>> download ${LLVM_TARBALL} attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && for i in 1 2 3 4 5; do \
         wget -q --tries=3 --timeout=120 "${DEPS_BASE}/${TRITON_DEPS_TARBALL}" -O "${TRITON_DEPS_TARBALL}" && break; \
         echo ">>> download ${TRITON_DEPS_TARBALL} attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C "${LLVM_DIR}" --strip-components=1 \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -f "${LLVM_DIR}/include/lld/Common/Driver.h" \
    && test -f "${LLVM_DIR}/lib/cmake/lld/LLDConfig.cmake" \
    && test -f "${LLVM_DIR}/lib/cmake/mlir/MLIRConfig.cmake" \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && test -d /root/.triton/nvidia/cudart \
    && test -d /root/.triton/nvidia/cupti \
    && printf '%s\n' "${LLVM_HASH}" > /opt/flagtree-build-env.llvm \
    && touch /opt/flagtree-build-env.ready

# The venv's bin first, so stage 2's `python3.12` is the one the build tools are
# installed into. Set here rather than as an ARG because ENV is what crosses FROM.
ENV PATH=/opt/build-venv/bin:${PATH}

COPY patch-flagtree-version.py /usr/local/bin/patch-flagtree-version.py

FROM builder AS flagtree

# Stage-scoped, so every arg this stage reads is declared again: ARGs do not
# carry across FROM, while the stage's filesystem and ENV do.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The release configs.yaml pins for this backend; a daily run overrides both.
ARG FLAGTREE_VERSION=0.7.0+ppu3.6
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
# Declared again for the same reason as the proxy args: ARGs do not cross FROM,
# and this stage is where pip runs.
ARG EXTRA_PYPI=https://mirrors.cloud.tencent.com/pypi/simple
# The vendor wheel's own pybind11 (internals v11), which is also this build's, so
# the two libtriton.so are drop-in counterparts and can be A/B'd.
ARG PYBIND11_VERSION=3.0.3
ARG MAX_JOBS=32

# THE STALENESS GATE IS THE FIRST CHECK. LLVM_SYSPATH makes FlagTree skip its own
# download and trust the tree silently, so the hash stage 1 recorded is compared
# against the source about to be compiled. .git goes after its sha is read,
# because FlagTree appends "+git<sha>" whenever `git rev-parse` answers.
#
# The sha travels in a setup.cfg setuptools merges into setup() on its own (see
# the README). Upstream shipping one is a hard failure rather than a merge: it
# would silently change what this line means.
#
# TRITON_BUILD_PROTON=OFF like amd: the profiler is not part of what the runtime
# uses, and inductor's proton_profiling probe was measured identical without it.
# USE_FLAGCX=OFF because the runtime installs the flagcx package and ppu is not
# in FlagTree's FLAGCX_SUPPORT_BACKENDS anyway.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && staged_hash="$(cat /opt/flagtree-build-env.llvm 2>/dev/null || true)" \
    && test -n "${staged_hash}" \
    && source_hash="$(head -c 8 /opt/flagtree/cmake/llvm-hash.txt)" \
    && if [ "${source_hash}" != "${staged_hash}" ]; then \
         echo "ERROR: the builder staged LLVM ${staged_hash}, FlagTree is on ${source_hash}" >&2; \
         exit 1; \
       fi \
    && echo ">>> LLVM ${staged_hash} matches the staged tree" \
    && python3.12 /usr/local/bin/patch-flagtree-version.py /opt/flagtree \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && rm -rf /opt/flagtree/.git \
    && cd /opt/flagtree \
    && python3.12 -m pip install --no-cache-dir --index-url "${EXTRA_PYPI}" -r python/requirements.txt \
    && python3.12 -m pip install --no-cache-dir --index-url "${EXTRA_PYPI}" "pybind11==${PYBIND11_VERSION}" \
    && export FLAGTREE_BACKEND=ppu \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export TRITON_BUILD_PROTON=OFF \
    && export USE_FLAGCX=OFF \
    && export MAX_JOBS="${MAX_JOBS}" \
    && for i in 1 2 3 4 5; do \
         python3.12 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# No objdump glibc gate, unlike amd: this is a 24.04 build installed on 24.04, and
# the vendor wheel carries the same floor, so a floor assertion would say nothing
# a client could violate. What is asserted is what this file is responsible for.
#
# printf to a file, not `python3.12 - <<'PY'`: on Docker's legacy builder a heredoc
# never reaches the command.
RUN printf '%s\n' \
      'import glob, os, re, sys, zipfile' \
      'import pybind11' \
      '' \
      'whl = glob.glob("/wheels/*.whl")' \
      'if len(whl) != 1:' \
      '    print("FAIL: expected one wheel, found " + str(whl))' \
      '    sys.exit(1)' \
      'whl = whl[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if "git" in ver:' \
      '    print("FAIL: dirty wheel version " + ver)' \
      '    sys.exit(1)' \
      'if "cp312" not in name:' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp312)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name)' \
      '' \
      'z = zipfile.ZipFile(whl)' \
      'entries = z.namelist()' \
      'for want in ("triton/_C/libtriton.so",' \
      '             "triton/backends/ppu/compiler.py",' \
      '             "triton/backends/ppu/driver.py",' \
      '             "triton/backends/ppu/lib/libdevice.ppu.bc",' \
      '             "triton/tools/extra/ppu/compile.c"):' \
      '    if want not in entries:' \
      '        print("FAIL: " + want + " missing from the wheel")' \
      '        sys.exit(1)' \
      'print("OK: ppu backend, libtriton.so and the ppu tool sources are in the wheel")' \
      '' \
      'marker = z.read("triton/FLAGTREE_BACKEND").decode().strip()' \
      'if marker != "ppu":' \
      '    print("FAIL: FLAGTREE_BACKEND is " + repr(marker) + ", expected ppu")' \
      '    sys.exit(1)' \
      'print("OK: the wheel names ppu as its backend")' \
      '' \
      'meta = z.read(next(n for n in entries if n.endswith(".dist-info/METADATA"))).decode()' \
      'urls = [l for l in meta.splitlines() if l.startswith("Project-URL: Source-Commit, ")]' \
      'if len(urls) != 1 or not urls[0].startswith(' \
      '        "Project-URL: Source-Commit, https://github.com/flagos-ai/flagtree/commit/"):' \
      '    print("FAIL: METADATA carries " + str(urls))' \
      '    sys.exit(1)' \
      'print("OK: " + urls[0])' \
      '' \
      'hdr = os.path.join(pybind11.get_include(), "pybind11", "detail", "internals.h")' \
      'm = re.search(r"#\s*define\s+PYBIND11_INTERNALS_VERSION\s+(\d+)", open(hdr).read())' \
      'want = m.group(1)' \
      'bad = []' \
      'for n in entries:' \
      '    if not n.endswith(".so"):' \
      '        continue' \
      '    got = sorted(set(int(x) for x in re.findall(rb"__pybind11_internals_v(\d+)", z.read(n))))' \
      '    if got and got != [int(want)]:' \
      '        bad.append((n, got))' \
      'if bad:' \
      '    print("FAIL: pybind11 internals " + str(bad) + ", this build provides v" + want)' \
      '    sys.exit(1)' \
      'print("OK: shipped .so files carry pybind11 internals v" + want + ", this build'"'"'s pybind11 " + pybind11.__version__)' \
    > /tmp/gate.py \
    && python3.12 /tmp/gate.py

# Smoke test: install from a directory of its own, so a passing import cannot be
# this builder's source tree, then assert what the .git removal and
# FLAGTREE_BACKEND=ppu are each responsible for.
RUN python3.12 -m pip install --no-cache-dir --no-deps --target /opt/wheel-test /wheels/*.whl \
    && PYTHONPATH=/opt/wheel-test WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" WHEEL_VER="${FLAGTREE_WHEEL_VERSION}" \
       python3.12 -c "\
import importlib.metadata as md, os, triton;\
from triton.backends import backends;\
assert triton.__file__.startswith('/opt/wheel-test'), triton.__file__;\
assert 'ppu' in backends, sorted(backends);\
assert md.version(os.environ['WHEEL_NAME']) == os.environ['WHEEL_VER'], (md.version(os.environ['WHEEL_NAME']), os.environ['WHEEL_VER']);\
assert 'git' not in md.version(os.environ['WHEEL_NAME']);\
print('OK', os.environ['WHEEL_NAME'], md.version(os.environ['WHEEL_NAME']), 'triton', triton.__version__, 'backends', sorted(backends))"
