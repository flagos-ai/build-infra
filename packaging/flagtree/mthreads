# Build a FlagTree mthreads (MUSA) wheel on Ubuntu 22.04 (glibc 2.35, gcc 11.4)
# with the 22.04 system python 3.10, which is what configs.yaml pins for both
# mthreads backends. The runtime is 24.04, and building for 22.04 only has to
# import there -- the direction glibc compatibility runs in.
#   docker build --target builder -t flagtree-builder-mthreads:ci -f mthreads .
#   docker build -t flagtree-mthreads:0.7.0 -f mthreads .

ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

# Proxy is consumed during build only -- an ARG is not persisted in the image.
# no_proxy is declared too: an undeclared ARG of that name is not inherited.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The prebuilt inputs, staged on our own filestore: ks3 answers the CI proxy with
# 500. Both names are FlagTree's own cache keys -- mthreads.py declares
# `mthreads-llvm22` and `mthreads_local_binary` and re-downloads a cache it does
# not recognize by that name, and both tarballs are rooted at exactly it.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG LLVM_TARBALL=mthreads-llvm22-x64_v0.6.1.tar.gz
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz

# The local binary is the one staged input that moves between the refs this file
# serves: mthreads.py declares v0.7.0 on `main`, v0.6.1 on the tag the wheel stage
# defaults to. FlagTree adopts a cache by DIRECTORY name and never compares
# versions, so the default below follows the daily's ref (`main`) and a build on
# the tag passes the other name.
ARG LOCAL_BINARY_TARBALL=mthreads_local_binary_v0.7.0.tar.gz

ENV DEBIAN_FRONTEND=noninteractive

# No clang is installed: FlagTreeOptions.cmake puts the staged LLVM's bin on PATH
# and names its clang/clang++ as the compilers for this backend, so an apt clang
# would be a second one it never looks at.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git wget curl binutils \
        build-essential cmake ninja-build \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        python3.10 python3.10-dev python3.10-venv python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && printf '[global]\nindex-url = https://mirrors.aliyun.com/pypi/simple/\n' > /etc/pip.conf \
    && python3.10 -m pip install --no-cache-dir --upgrade pip wheel setuptools \
    && mkdir -p /root/.flagtree/mthreads /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${LOCAL_BINARY_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           wget -q --tries=3 --timeout=60 "${DEPS_BASE}/${f}" -O "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C /root/.flagtree/mthreads \
    && tar -xzf "${LOCAL_BINARY_TARBALL}" -C /root/.flagtree/mthreads \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -x /root/.flagtree/mthreads/mthreads-llvm22/bin/clang \
    && test -f /root/.flagtree/mthreads/mthreads-llvm22/bin/FileCheck \
    && test -f /root/.flagtree/mthreads/mthreads-llvm22/lib/cmake/mlir/MLIRConfig.cmake \
    && test -f /root/.flagtree/mthreads/mthreads-llvm22/lib/cmake/lld/LLDConfig.cmake \
    && test -x /root/.flagtree/mthreads/mthreads_local_binary/llc \
    && test -x /root/.flagtree/mthreads/mthreads_local_binary/ld.lld \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && touch /opt/flagtree-build-env.ready

# The staged caches are read by DIRECTORY NAME, which is what makes both
# extractions correct without a strip and what the assertions above name. The
# triton toolkits tarball is different -- it is rooted at `.triton/`, so it is
# stripped or it lands one level below what FlagTree reads.

# LLVM_SYSPATH is deliberately NOT set: mthreads.py's LLVM cache entry
# short-circuits on it (`pre_hook=check_env("LLVM_SYSPATH")`), so setting it
# bypasses the staged tree and sends the build to the vendor's ks3 bucket. Its
# post_hook is what exports LLVM_SYSPATH, LLVM_INCLUDE_DIRS, LLVM_LIBRARY_DIR and
# the mlir_core PYTHONPATH -- staging without the variables is what lets it run.

FROM builder AS flagtree

# Stage-scoped, so every arg the wheel build reads is declared again. BuildKit
# inherits a parent stage's ARGs into a `FROM parent` child and the legacy
# builder does not, so an ARG declared only above is empty on half the runners.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# FlagTree ref, the single version knob; the backend is selected at build time via
# FLAGTREE_BACKEND, not by source. The default is the release configs.yaml pins for
# mthreads-musa4.3.6 and mthreads-musa5.2.0 -- a client installs this wheel's
# version, so the two must not drift. A daily run overrides it.
ARG FLAGTREE_VERSION=0.7.0+mthreads3.6

# Wheel version, defaulting to the ref so one arg drives both. FlagTree appends a
# dirty "+git<sha>" unless it holds the vendor's FLAGTREE_PYPI_KEY or finds no
# .git dir, so the build removes .git before `pip wheel`.
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=

# No pybind11 pin: mthreads.py ships no pybind11 internals table and no prebuilt .so
# is an ABI counterparty -- every binding in this wheel is compiled here from one
# pybind11. The gate asserts the invariant a pin would otherwise carry.
ARG MAX_JOBS=32

# THE SHA IS READ BEFORE .git GOES, AND BOTH BEFORE `pip wheel`: the version has
# to come out clean, so .git must not exist when setup.py asks, while the commit
# id is worth keeping, so it goes into a setup.cfg that setuptools merges into
# setup() on its own. FlagTree ships no setup.cfg of its own, so its absence is
# asserted rather than assumed.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && cd /opt/flagtree \
    && python3.10 -m pip install --no-cache-dir -r python/requirements.txt \
    && export FLAGTREE_BACKEND=mthreads \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export TRITON_APPEND_CMAKE_ARGS="-DCMAKE_BUILD_TYPE=Release" \
    && export MAX_JOBS="${MAX_JOBS}" \
    && rm -rf /opt/flagtree/.git \
    && for i in 1 2 3 4 5; do \
         python3.10 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# printf to a file, not `python - <<'PY'`: on Docker's legacy builder a heredoc
# never reaches python's stdin and the step passes having asserted nothing.
RUN printf '%s\n' \
      'import glob, os, re, subprocess, sys, tempfile, zipfile' \
      '' \
      'whl = glob.glob("/wheels/*.whl")[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if "git" in ver:' \
      '    print("FAIL: dirty wheel version " + ver + " (expected clean, no git-sha suffix)")' \
      '    sys.exit(1)' \
      'if "cp310" not in name:' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp310)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name + " version " + ver)' \
      '' \
      'd = tempfile.mkdtemp()' \
      'zf = zipfile.ZipFile(whl)' \
      'zf.extractall(d)' \
      'for p in ("triton/backends/mthreads/__init__.py", "triton/backends/mthreads/compiler.py",' \
      '          "triton/backends/mthreads/driver.py", "triton/backends/mthreads/bin/llc",' \
      '          "triton/backends/mthreads/bin/ld.lld"):' \
      '    if not os.path.exists(os.path.join(d, p)):' \
      '        print("FAIL: " + name + " ships no " + p + " (wrong FLAGTREE_BACKEND, or the local binary cache was not read)")' \
      '        sys.exit(1)' \
      'print("OK: wheel ships the mthreads backend package and the local llc/ld.lld")' \
      '' \
      'so = os.path.join(d, "triton", "_C", "libtriton.so")' \
      'if not os.path.exists(so):' \
      '    print("FAIL: no triton/_C/libtriton.so in " + name)' \
      '    sys.exit(1)' \
      'syms = subprocess.check_output(["objdump", "-T", so], text=True)' \
      'forbidden = ["GLIBC_2.38", "GLIBCXX_3.4.31", "GLIBCXX_3.4.32", "__isoc23_"]' \
      'hits = [f for f in forbidden if f in syms]' \
      'if hits:' \
      '    print("FAIL: 22.04-incompatible symbols in libtriton.so: " + str(hits))' \
      '    sys.exit(1)' \
      'maxglibc = max(set(re.findall(r"GLIBC_[0-9.]+", syms)), key=lambda v: [int(x) for x in v[6:].split(".")])' \
      'print("OK: libtriton.so is 22.04-clean (max " + maxglibc + ", no forbidden symbols)")' \
      '' \
      'import pybind11' \
      'hdr = os.path.join(pybind11.get_include(), "pybind11", "detail", "internals.h")' \
      'm = re.search(r"#\s*define\s+PYBIND11_INTERNALS_VERSION\s+(\d+)", open(hdr).read())' \
      'if not m:' \
      '    print("FAIL: no PYBIND11_INTERNALS_VERSION in " + hdr)' \
      '    sys.exit(1)' \
      'want = m.group(1).encode()' \
      'tagged = lambda p: sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", open(p, "rb").read())))' \
      'sos = sorted(glob.glob(d + "/triton/_C/*.so"))' \
      'bad = {os.path.basename(p): tagged(p) for p in sos if tagged(p) and tagged(p) != [want]}' \
      'if tagged(so) != [want] or bad:' \
      '    print("FAIL: pybind11 internals " + str(tagged(so)) + " in libtriton.so, " + str(bad) + " elsewhere; the build installed pybind11 " + pybind11.__version__ + " which provides v" + want.decode())' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so and every tagged .so in _C carry pybind11 internals v" + want.decode() + ", matching the build pybind11 " + pybind11.__version__)' \
    > /tmp/gate.py \
    && python3.10 /tmp/gate.py

# Smoke test: install the freshly built wheel, import it, and assert the two
# things the version pin and the setup.cfg carrier are for. This backend's driver
# imports torch and looks for libmusa.so inside its methods, not at module scope,
# so an import here reaches the backend without a MUSA device.
RUN python3.10 -m pip install --no-cache-dir /wheels/*.whl \
    && python3.10 -c "\
import importlib.metadata as md, triton;\
from triton.backends import backends;\
print('OK', md.version('${FLAGTREE_WHEEL_NAME}'), 'triton', triton.__version__, 'backends', sorted(backends));\
assert 'mthreads' in backends, sorted(backends);\
urls = md.metadata('${FLAGTREE_WHEEL_NAME}').get_all('Project-URL') or [];\
print('OK', [u for u in urls if u.startswith('Source-Commit')]);\
assert any(u.startswith('Source-Commit, https://github.com/flagos-ai/flagtree/commit/') for u in urls), urls;\
assert md.version('${FLAGTREE_WHEEL_NAME}') == '${FLAGTREE_WHEEL_VERSION}', md.version('${FLAGTREE_WHEEL_NAME}');\
assert 'git' not in md.version('${FLAGTREE_WHEEL_NAME}'), md.version('${FLAGTREE_WHEEL_NAME}')"
