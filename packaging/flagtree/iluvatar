# FlagTree iluvatar (CoreX) wheel on Ubuntu 22.04: the vendor's 24.04 wheel needs
# a newer glibc than a 22.04 client has. `--target builder` is the build machine;
# the default target builds the wheel.
#
#   docker build --target builder -t flagtree-builder-iluvatar-corex4.5.0:ci -f iluvatar .
#   docker build -t flagtree-iluvatar:0.7.1a1 -f iluvatar .
#   id=$(docker create flagtree-iluvatar:0.7.1a1); docker cp $id:/wheels ./wheels

ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG FILESTORE=https://resource.flagos.net/repository/flagos-filestore
ARG LLVM_TARBALL=iluvatar-llvm22-x86_64_v0.6.1.tar.gz
# Rooted at `.triton/`; the LLVM keeps its root -- the backend resolves that
# cache by the tarball's own name.
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz
ARG UV_VERSION=0.11.30
ARG PYTHON_VERSION=3.12
ENV DEBIAN_FRONTEND=noninteractive
# uv and CPython off the internal filestore (the international link is the flaky
# part on CN runners), the index off the CN mirror.
ENV UV_PYTHON_INSTALL_MIRROR=${FILESTORE}/uv-python \
    UV_DEFAULT_INDEX=https://mirrors.aliyun.com/pypi/simple \
    UV_HTTP_TIMEOUT=120
# /flagos is the runtime image's shape, so the cp tag matches; pip's resume
# ceiling is raised because this link drops mid-stream on large downloads.
ENV VIRTUAL_ENV=/flagos \
    PATH="/flagos/bin:${PATH}" \
    PIP_RESUME_RETRIES=100

# The marker is written last: on top of the published builder every line below is
# already in the image, and the guard is what skips it.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git wget curl binutils \
        build-essential cmake ninja-build \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        libncurses5-dev libncursesw5-dev libgdbm-dev libnss3-dev \
        libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
        libdb5.3-dev libbz2-dev libexpat1-dev liblzma-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl -LsSf "${FILESTORE}/utils/uv-$(uname -m)-${UV_VERSION}-linux-gnu.tar.gz" \
         | tar xz -C /usr/local/bin --strip-components=1 \
    && uv python install "${PYTHON_VERSION}" --python-preference only-managed -q \
    && uv venv /flagos --python "${PYTHON_VERSION}" --relocatable --seed \
    && printf '[global]\nindex-url = https://mirrors.aliyun.com/pypi/simple/\n' > /etc/pip.conf \
    && pip install --no-cache-dir --upgrade pip \
    && mkdir -p /root/.flagtree/iluvatar /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           wget -q --tries=3 --timeout=60 "${DEPS_BASE}/${f}" -O "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C /root/.flagtree/iluvatar \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -f /root/.flagtree/iluvatar/iluvatar-llvm22-x86_64/lib/cmake/mlir/MLIRConfig.cmake \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && touch /opt/flagtree-build-env.ready

FROM builder AS flagtree

ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

ARG FLAGTREE_VERSION=0.7.1a1+iluvatar3.6
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=

# pybind11 ABI parity with the vendor wheel, whose libtriton.so is internals v12
# (measured on flagtree==0.7.0rc2+iluvatar3.6). No prebuilt .so is an ABI
# counterparty here -- the plugin is compiled from source and linked in -- so the
# gate compares libtriton against the pybind11 this build actually installed.
ARG PYBIND11_SPEC=>=3.1,<3.2
ARG MAX_JOBS=32

# Only binary caches are staged; FlagTree clones its own third-party sources.
# TRITON_OFFLINE_BUILD=1 (the vendor's setting) makes setup.py reject a
# dependency whose syspath is unset, so the staged caches are what gets read.
# USE_FLAGCX=OFF keeps FlagCX out of the wheel: compiling it needs the CoreX
# SDK and clang, which the flagcx line owns.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && cd /opt/flagtree \
    && python -m pip install --no-cache-dir -r python/requirements.txt \
    && python -m pip install --no-cache-dir "pybind11${PYBIND11_SPEC}" \
    && export FLAGTREE_BACKEND=iluvatar \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export TRITON_OFFLINE_BUILD=1 TRITON_BUILD_PROTON=OFF TRITON_ILU_BUILD_GLUON=OFF \
    && export USE_FLAGCX=OFF \
    && export MAX_JOBS="${MAX_JOBS}" \
    && rm -rf /opt/flagtree/.git \
    && for i in 1 2 3 4 5; do \
         python -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && test ! -e /opt/flagtree/third_party/iluvatar/tle/third_party/flagcx \
    && ls -la /wheels/*.whl

# printf to a file, not `python - <<'PY'`: on the Docker legacy builder the CoreX
# nodes run, a heredoc never reaches python's stdin and the step passes having
# asserted nothing.
# The plugin is linked into libtriton.so, so its symbol is the proof, not a .so.
RUN printf '%s\n' \
      'import glob, os, re, subprocess, sys, tempfile, zipfile' \
      '' \
      'whl = glob.glob("/wheels/*.whl")[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if "git" in ver:' \
      '    print("FAIL: dirty wheel version " + ver + " (expected clean, no git<sha> suffix)")' \
      '    sys.exit(1)' \
      'if "cp312" not in name:' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp312)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name + " version " + ver)' \
      '' \
      'd = tempfile.mkdtemp()' \
      'zipfile.ZipFile(whl).extractall(d)' \
      'so = os.path.join(d, "triton", "_C", "libtriton.so")' \
      'if not os.path.exists(so):' \
      '    print("FAIL: no triton/_C/libtriton.so in " + name)' \
      '    sys.exit(1)' \
      'syms = subprocess.check_output(["objdump", "-T", so], text=True)' \
      'forbidden = ["GLIBC_2.38", "GLIBCXX_3.4.31", "GLIBCXX_3.4.32", "__isoc23_"]' \
      'hits = [f for f in forbidden if f in syms]' \
      'if hits:' \
      '    print("FAIL: 22.04-incompatible symbols in libtriton.so: " + str(hits))' \
      '    sys.exit(1)' \
      'maxglibc = max(set(re.findall(r"GLIBC_[0-9.]+", syms)), key=lambda v: [int(x) for x in v[6:].split(".")])' \
      'print("OK: libtriton.so is 22.04-clean (max " + maxglibc + ", no forbidden symbols)")' \
      '' \
      'if "translateLLVMIRToILUVATAR" not in syms:' \
      '    print("FAIL: the iluvatar plugin is not linked into libtriton.so")' \
      '    sys.exit(1)' \
      'print("OK: iluvatar plugin is linked into libtriton.so")' \
      '' \
      'stray = [n for n in zipfile.ZipFile(whl).namelist() if "flagcx" in n.lower()]' \
      'if stray:' \
      '    print("FAIL: USE_FLAGCX=OFF did not keep FlagCX out of the wheel: " + str(stray[:5]))' \
      '    sys.exit(1)' \
      'print("OK: no FlagCX in the wheel")' \
      '' \
      'blob = open(so, "rb").read()' \
      'got = sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", blob)))' \
      'if not got:' \
      '    print("FAIL: libtriton.so carries no pybind11 internals tag")' \
      '    sys.exit(1)' \
      'import pybind11' \
      'hdr = os.path.join(pybind11.get_include(), "pybind11", "detail", "internals.h")' \
      'm = re.search(r"#\s*define\s+PYBIND11_INTERNALS_VERSION\s+(\d+)", open(hdr).read())' \
      'if not m:' \
      '    print("FAIL: no PYBIND11_INTERNALS_VERSION in " + hdr)' \
      '    sys.exit(1)' \
      'want = m.group(1).encode()' \
      'if got != [want]:' \
      '    print("FAIL: libtriton.so pybind11 internals " + str(got) + ", the pybind11 this build installed (" + pybind11.__version__ + ") provides [" + repr(want) + "]")' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so carries pybind11 internals v" + want.decode() + ", matching the build pybind11 " + pybind11.__version__)' \
    > /tmp/gate.py \
    && python /tmp/gate.py

# PYTHONPATH dropped so nothing outside this venv can satisfy the import.
RUN pip install --no-cache-dir /wheels/*.whl \
    && env -u PYTHONPATH python -c "import triton; from triton.backends import backends; \
         print('OK triton', triton.__version__, triton.__file__); \
         print('OK backends', list(backends.keys()))" \
    && env -u PYTHONPATH python -c "import flagtree; print('OK flagtree', flagtree.__file__)" \
    && env -u PYTHONPATH python -c "import importlib.metadata as md;\
         print('OK', md.version('${FLAGTREE_WHEEL_NAME}'));\
         urls = md.metadata('${FLAGTREE_WHEEL_NAME}').get_all('Project-URL') or [];\
         print('OK', [u for u in urls if u.startswith('Source-Commit')]);\
         assert any(u.startswith('Source-Commit, https://github.com/flagos-ai/flagtree/commit/') for u in urls), urls;\
         assert md.version('${FLAGTREE_WHEEL_NAME}') == '${FLAGTREE_WHEEL_VERSION}', md.version('${FLAGTREE_WHEEL_NAME}');\
         assert 'git' not in md.version('${FLAGTREE_WHEEL_NAME}')"
