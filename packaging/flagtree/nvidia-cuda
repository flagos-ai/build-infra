# Build a FlagTree wheel for the NVIDIA backend on Ubuntu 22.04 (glibc 2.35) so
# the resulting libtriton.so links against an older glibc and loads on
# older-glibc nodes (e.g. the h20 CI runner, ubuntu 22.04 / glibc 2.35).
#
# TWO STAGES, ONE FILE. `--target builder` is the build machine -- apt toolchain,
# python 3.12 and the prebuilt LLVM, everything that does not depend on the
# FlagTree ref -- and is published to the builder prefix by
# flagtree-builder-nvidia.yml. The default target is the wheel build on top of
# it, writing to /wheels. Passing that published image as BUILDER_IMAGE turns
# stage 1 into a no-op, so a build pays for the clone and the compile and nothing
# else; stage 1 says so with a marker file (see the guard below).
#
# Build:
#   podman build -t flagtree-build:0.7.0 -f nvidia-cuda .
#   # behind a proxy:
#   podman build --build-arg http_proxy=$http_proxy --build-arg https_proxy=$https_proxy \
#                -t flagtree-build:0.7.0 -f nvidia-cuda .
#   # the build machine on its own:
#   docker build --target builder -t flagtree-builder-nvidia-cuda:ci -f nvidia-cuda .
#
# Extract the wheel:
#   id=$(podman create flagtree-build:0.7.0); podman cp $id:/wheels ./wheels; podman rm $id

# The build machine, and the one knob that distinguishes a cold build from a warm
# one: pointing this at the published builder stage turns everything below it into
# a no-op. It is a plain image ref, so a registry pull needs no login of its own.
ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

# Proxy is only consumed during build (predefined ARG, not persisted in the image).
# no_proxy rides along because the LLVM tarball below is fetched from the internal
# filestore, which the CI runner reaches directly -- proxied, that fetch is refused.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=
# Prebuilt LLVM. FlagTree's cmake wants an LLVM install tree and otherwise fetches
# 1.2 GB from Azure at build time -- on a CN runner the slowest and least reliable
# step of the whole build. The same tree is mirrored in the internal filestore, so
# stage it here and hand it to FlagTree via LLVM_SYSPATH, the knob FlagTree
# documents for a pre-installed LLVM (its own CI drives the thrive backend the
# same way).
#
# LLVM_HASH is the first 8 characters of FlagTree's cmake/llvm-hash.txt, which is
# both the tarball's name and the revision the tree is. FlagTree validates nothing
# about LLVM_SYSPATH -- a staged tree is trusted and used silently -- so the stage
# records the hash it staged and the wheel build compares that record against the
# source it just cloned. Bumping this hash means republishing the builder.
ARG FILESTORE=https://resource.flagos.net/repository/flagos-filestore
ARG LLVM_HASH=f6ded0be
ARG LLVM_TARBALL=llvm-${LLVM_HASH}-ubuntu-x64.tar.gz
ARG LLVM_DIR=/opt/llvm-${LLVM_HASH}-ubuntu-x64

# LLVM_SYSPATH alone is the contract: get_thirdparty_packages() reads it, skips
# both the download and its own version.txt check, and derives the include and
# library flags from it. LLVM_INCLUDE_DIRS / LLVM_LIBRARY_DIR are deliberately not
# set as well -- they add nothing once the syspath is there, and any of the three
# trips LLVMDetector into aborting the build if an mlir wheel is ever installed
# beside them. ENV rather than ARG because stage 2 is where it is consumed and ENV
# is what crosses FROM.
#
# TRITON_OFFLINE_BUILD is deliberately NOT set. On the default (nvidia) backend it
# demands eight CUDA toolkit directories under ~/.triton plus an offline directory
# holding FlagPrism and flagcx, and fails the build without them. The other
# builders can set it because their backends stage that cache; nvidia has none.
ENV LLVM_SYSPATH=${LLVM_DIR}
ENV DEBIAN_FRONTEND=noninteractive

# System build deps for the LLVM/Triton native build + Python 3.12 (deadsnakes).
#
# THE DEADSNAKES PPA IS WIRED UP BY HAND, NOT WITH add-apt-repository. That
# command resolves the PPA through Launchpad's REST API, and the CI runner's
# proxy answers the CONNECT to api.launchpad.net with 500 -- the build dies in
# under a minute, before anything else runs. The two hosts actually needed, the
# key server and the package archive, are both reachable from that runner, so
# the key is fetched and the source line written directly. The codename is
# jammy because this stage is ubuntu:22.04 by design (see the file header);
# moving to another base means moving it here too.
#
# THE MARKER IS THE WHOLE POINT OF THE FIRST LINE. Built on top of a published
# builder, this stage's earlier work is already in the image's layers, but the
# instruction still runs -- so without the guard every warm build would reinstall
# the same apt packages and re-fetch the same 1.2 GB tarball before reaching the
# clone. The marker is written last, so a build that died halfway is retried
# rather than trusted.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates gnupg curl \
        git wget \
    && curl -fsSL \
         "https://keyserver.ubuntu.com/pks/lookup?op=get&search=0xF23C5A6CF475977595C89F51BA6932366A755776" \
         | gpg --dearmor -o /etc/apt/trusted.gpg.d/deadsnakes.gpg \
    && echo "deb https://ppa.launchpadcontent.net/deadsnakes/ppa/ubuntu jammy main" \
         > /etc/apt/sources.list.d/deadsnakes.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        libncurses5-dev libncursesw5-dev libgdbm-dev libnss3-dev \
        libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
        libdb5.3-dev libbz2-dev libexpat1-dev liblzma-dev \
        python3.12 python3.12-venv python3.12-dev \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m ensurepip --upgrade \
    && python3.12 -m pip install --no-cache-dir --upgrade pip wheel setuptools \
    && cd /tmp \
    && for i in 1 2 3 4 5; do \
         wget -q --tries=3 --timeout=120 "${FILESTORE}/llvm/${LLVM_TARBALL}" -O "${LLVM_TARBALL}" && break; \
         echo ">>> download ${LLVM_TARBALL} attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && mkdir -p "${LLVM_DIR}" \
    && tar -xzf "${LLVM_TARBALL}" -C "${LLVM_DIR}" --strip-components=1 \
    && rm -f "${LLVM_TARBALL}" \
    && test -d "${LLVM_DIR}/lib/cmake/mlir" \
    && printf '%s\n' "${LLVM_HASH}" > /opt/flagtree-build-env.llvm \
    && touch /opt/flagtree-build-env.ready

# Make print(flagtree.__version__) answer "which FlagTree is this?". Idempotent.
# Fails the build if upstream's python/flagtree/__init__.py is changed.
COPY patch-flagtree-version.py /usr/local/bin/patch-flagtree-version.py

FROM builder AS flagtree

# Stage-scoped, so every arg the wheel build reads is declared again: ARGs do not
# carry across FROM, while the stage's filesystem and ENV do.
ARG FLAGTREE_VERSION=0.7.0
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
#  - FLAGTREE_WHEEL_VERSION is the env var FlagTree's setup.py reads for the wheel
#    version; it defaults to FLAGTREE_VERSION so one arg drives both.
#    The version comes out clean (no +git<sha>) because .git is removed before
#    `pip wheel` -- the metax/sunrise/ascend route. FlagTree appends the sha in
#    get_git_commit_hash() whenever `git rev-parse` answers, and that is the only
#    thing .git is still needed for here (the sha itself, read a few lines above
#    the removal, goes into the wheel metadata instead -- see the build RUN).
#    FLAGTREE_PYPI_KEY, the other way to a clean version, is not used: its value
#    is a secret this repo does not hold, and the ARG below stays for callers
#    that do.
#  - FLAGTREE_WHEEL_NAME is the distribution name, read by setup.py the same way.
#    The release line publishes plain "flagtree"; the daily line publishes
#    "flagtree-nvidia" so a consumer can name the backend and let pip pick the
#    newest build (see packaging/flagtree/README.md).

ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=

# Build the FlagTree wheel from source.
# Unconditionally use the proxy (as build-args). Force HTTP/1.1 for git.
#
# THE FIRST CHECK IS THE STALENESS GATE. LLVM_SYSPATH points FlagTree at whatever
# tree stage 1 staged, and FlagTree asks that tree nothing -- a build against the
# wrong revision fails deep in triton's cmake, or worse, succeeds and produces a
# wheel nobody can attribute. Two things can go wrong, and both are decidable
# here: the record stage 1 left can name a different revision than the source
# just cloned, or LLVM_SYSPATH can name a tree that is not in this image at all.
#
# THE SHA IS READ BEFORE .git GOES, AND BOTH COME BEFORE `pip wheel`. Deleting
# .git so that the version clean: FlagTree appends "+git<sha>" in
# get_git_commit_hash() whenever `git rev-parse` answers, and `git` is not
# installed in the wheel's runtime anyway.
# Order is the whole trick: read the sha, write the carrier, only then delete.
#
# FlagTree has no setup.cfg of its own, and setuptools merges one into the setup()
# call on its own. With setup.cfg, the METADATA `Project-URL: Source-Commit, <url>`
# can provide git commit ID information. The guard is a hard failure rather than a
# merge because upstream shipping one would silently change what this line means.
# FLAGCX IS SWITCHED OFF. When turned on, a FlagCX distribution is embedded into
# the release wheel. The runtime already installs the flagcx package.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && staged_hash="$(cat /opt/flagtree-build-env.llvm 2>/dev/null || true)" \
    && if [ -z "${staged_hash}" ]; then \
         echo "ERROR: no staged-LLVM record -- the base image was not produced by" >&2; \
         echo "       this file's builder stage. Republish it, or build cold with" >&2; \
         echo "       --build-arg BUILDER_IMAGE=ubuntu:22.04." >&2; \
         exit 1; \
       fi \
    && if [ ! -f "${LLVM_SYSPATH}/lib/cmake/mlir/MLIRConfig.cmake" ]; then \
         echo "ERROR: ${LLVM_SYSPATH} carries no LLVM install tree, but the builder" >&2; \
         echo "       staged LLVM ${staged_hash}. LLVM_HASH was bumped here without" >&2; \
         echo "       republishing, or BUILDER_IMAGE is not a builder image at all." >&2; \
         exit 1; \
       fi \
    && source_hash="$(head -c 8 /opt/flagtree/cmake/llvm-hash.txt)" \
    && if [ "${source_hash}" != "${staged_hash}" ]; then \
         echo "ERROR: the builder staged LLVM ${staged_hash}, FlagTree is on ${source_hash}" >&2; \
         echo "       Republish it: flagtree-builder-nvidia.yml." >&2; \
         exit 1; \
       fi \
    && echo ">>> LLVM ${staged_hash} matches the staged tree" \
    && python3.12 /usr/local/bin/patch-flagtree-version.py /opt/flagtree \
    && grep -q '_metadata.version("' /opt/flagtree/python/flagtree/__init__.py \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && rm -rf /opt/flagtree/.git \
    && cd /opt/flagtree \
    && python3.12 -m pip install --no-cache-dir -r python/requirements.txt \
    && export TRITON_APPEND_CMAKE_ARGS="-DCMAKE_BUILD_TYPE=Release" \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export USE_FLAGCX=OFF \
    && for i in 1 2 3 4 5; do \
         python3.12 -m pip wheel . --no-build-isolation -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && test ! -d /opt/flagtree/third_party/tle/third_party/flagcx \
    && ls -la /wheels/*.whl

# Smoke test: install the freshly built wheel and import it (fails the build if
# broken). The installed __version__ is the distribution's own version, so this
# asserts both the import and that the patch survived into the installed tree.
# The remaining assertions are what make the .git removal, the setup.cfg carrier.
RUN python3.12 -m pip install --no-cache-dir /wheels/*.whl \
    && python3.12 -c "\
import glob, importlib.metadata as md, zipfile, flagtree, triton;\
print('OK', md.version('${FLAGTREE_WHEEL_NAME}'), 'triton', triton.__version__);\
assert flagtree.__version__ == md.version('${FLAGTREE_WHEEL_NAME}'), flagtree.__version__;\
urls = md.metadata('${FLAGTREE_WHEEL_NAME}').get_all('Project-URL') or [];\
print('OK', [u for u in urls if u.startswith('Source-Commit')]);\
assert any(u.startswith('Source-Commit, https://github.com/flagos-ai/flagtree/commit/') for u in urls), urls;\
assert not md.version('${FLAGTREE_WHEEL_NAME}').split('+', 1)[1:], md.version('${FLAGTREE_WHEEL_NAME}');\
whl = glob.glob('/wheels/*.whl')[0];\
stray = [n for n in zipfile.ZipFile(whl).namelist() if 'flagcx' in n.lower()];\
assert not stray, stray;\
print('OK no flagcx in', whl)"
