# Build a FlagTree ascend3.5 wheel (Triton 3.5 / CANN 9.0.0 / aarch64 / cp311)
# from source. Output wheel -> /wheels.
#
# The ascend backends consume FlagTree as their default compiler and bought it
# from the vendor index (flagtree==0.6.1+ascend3.5); building it here makes the
# wheel self-owned and gives an A/B baseline against the vendor's.
#
# The base is the backend's own runtime image, not a bare ubuntu like the
# metax / nvidia-cuda / sunrise builders: FlagTree's ascend build selects its
# AscendNPU-IR pin from the CANN version found on the build machine and compiles
# it in (python/setup_tools/utils/ascend.py), and that image is already the full
# toolchain (cp311 venv, gcc/cmake, torch + torch_npu). Build env == delivery
# env, as in packaging/megatron/builder.
#
# Build:
#   docker build -t flagtree-ascend3.5:0.7.0rc2 -f ascend3.5 .
#   # when github needs a proxy (the build clones flir / FlagPrism / AscendNPU-IR):
#   docker build --build-arg PROXY_URL=$https_proxy \
#                -t flagtree-ascend3.5:0.7.0rc2 -f ascend3.5 .
#   # via CI: dispatch flagtree-wheel.yml with target=ascend3.5
#
# Extract the wheel:
#   id=$(docker create flagtree-ascend3.5:0.7.0rc2); docker cp $id:/wheels ./wheels; docker rm $id

# CI passes the full ref, registry host included, from configs.yaml; the default
# suits a manual local build.
ARG BASE_IMAGE=flagos-runtime-ascend-cann9.0.0:2.2.0
FROM ${BASE_IMAGE}

# Relayed by flagtree-wheel.yml as a FALLBACK for github traffic, applied only
# after a direct call fails: through the CANN nodes' proxy, git to github.com
# times out after ~130 s (run 35196654446). PROXY_NO_PROXY goes through verbatim
# — a NO_PROXY invented here would bypass the tunnel for hosts the container
# cannot resolve on its own.
ARG PROXY_URL=
ARG PROXY_NO_PROXY=

# FlagTree git ref to build: branch, tag or commit sha. Pin a sha for a release.
ARG FLAGTREE_VERSION=0.7.0-rc2-triton3.5
# Wheel version prefix: OUR label for the FlagTree line, not the vendor's release
# label. FlagTree's setup.py stamps "+git<sha>" unless it holds the vendor's
# secret key, so the build drops .git before `pip wheel` and the version comes out
# exactly as set here. The default adds the UTC build date (below) so a rebuild is
# distinguishable from the vendor's wheel.
ARG FLAGTREE_BASE_VERSION=0.7.0rc2+ascend3.5
# Explicit wheel version; blank = "<FLAGTREE_BASE_VERSION>.<UTC date>".
ARG FLAGTREE_WHEEL_VERSION=
# The CANN version the base image must provide. A gate, not decoration: the
# AscendNPU-IR pin follows the CANN on the build machine, so a wrong BASE_IMAGE
# would silently build against the wrong bishengir.
ARG CANN_VERSION=9.0.0
# Prebuilt deps by URL, same bucket as the metax / sunrise builders.
#  - llvm-7d5de303: its bin/ carries the clang this build compiles with.
#  - build-deps-triton: triton origin toolkits (nvcc/cudart + json/gtest).
ARG DEPS_BASE=https://baai-cp-web.ks3-cn-beijing.ksyuncs.com/trans
ARG LLVM_TARBALL=llvm-7d5de303-ubuntu-aarch64-python311-compat_v0.6.0.tar.gz
ARG LLVM_DIR=llvm-7d5de303-ubuntu-aarch64-python311-compat
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.5.x-linux-aarch64.tar.gz
# An ABI contract, not just a dependency: the runtime venv ships pybind11 3.0.3
# (internals v11) and an unpinned build pulls 3.1.x (v12), which imports fine but
# breaks at kernel-compile time on real hardware. Named _VERSION, not the _SPEC of
# the other builders: ARG splits on the first '=', so "ARG X==3.0.3" would hand
# pip "pybind11=3.0.3".
ARG PYBIND11_VERSION=3.0.3
# A contract with the prebuilt LLVM, not the runtime: its MLIRDetectPythonEnv.cmake
# asks for 2.4 while an unpinned install resolves to 3.x, which that request
# rejects — the build dies in cmake (run 35204674917). Build-time only.
ARG NANOBIND_VERSION=2.4.0
# Public index for the build requirements (pypi.org is unreachable from the runners).
ARG EXTRA_PYPI=https://mirrors.aliyun.com/pypi/simple
# AscendNPU-IR (a whole MLIR project) plus triton; upstream's delivery uses 32.
ARG MAX_JOBS=32

# bash, not the image's /bin/sh (dash): the CANN environment reaches
# non-interactive shells only through BASH_ENV + bash.
SHELL ["/bin/bash", "-c"]

# Stage the prebuilt deps into FlagTree's offline caches so the build wires them
# itself (the non-interactive equivalent of upstream's unpack_triton_build_deps.sh).
# Retries: the runners' link to the bucket is flaky. --noproxy: the proxy answers
# HTTP 500 for this bucket while the bucket is reachable directly.
RUN mkdir -p /root/.flagtree/ascend /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           curl -fsSL --noproxy '*' --retry 3 --retry-delay 5 --connect-timeout 30 \
             "${DEPS_BASE}/${f}" -o "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && tar -xzf "${LLVM_TARBALL}" -C /root/.flagtree/ascend \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -x "/root/.flagtree/ascend/${LLVM_DIR}/bin/clang" \
    && ls -la /root/.triton

# --branch cannot take a sha, so fetch + checkout FETCH_HEAD handles branch, tag
# and sha alike. HTTP/1.1 and the timeouts bound a hung github connection instead
# of stalling the build. Cloned to /opt/flagtree-src: /opt/flagtree is the vendor
# wheel inside the runtime image and must stay untouched.
RUN export GIT_HTTP_CONNECT_TIMEOUT=15 GIT_HTTP_LOW_SPEED_LIMIT=1000 GIT_HTTP_LOW_SPEED_TIME=30 \
    && git config --global http.version HTTP/1.1 \
    && unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY all_proxy ALL_PROXY \
    && if timeout 30 git ls-remote https://github.com/flagos-ai/flagtree HEAD >/dev/null 2>&1; then \
         echo ">>> github reachable directly, no proxy"; \
       elif [ -n "${PROXY_URL}" ]; then \
         export http_proxy="${PROXY_URL}" https_proxy="${PROXY_URL}" \
                no_proxy="${PROXY_NO_PROXY}" NO_PROXY="${PROXY_NO_PROXY}"; \
         echo ">>> github not directly reachable, using the relayed proxy"; \
       else \
         echo ">>> github not directly reachable and no proxy was relayed" >&2; exit 1; \
       fi \
    && for i in 1 2 3 4 5 6 7 8; do \
         rm -rf /opt/flagtree-src && git init -q /opt/flagtree-src \
           && git -C /opt/flagtree-src remote add origin https://github.com/flagos-ai/flagtree \
           && git -C /opt/flagtree-src fetch --depth 1 origin "${FLAGTREE_VERSION}" \
           && git -C /opt/flagtree-src checkout -q FETCH_HEAD && break; \
         echo ">>> flagtree fetch attempt $i failed, retrying in 5s..."; \
         sleep 5; \
       done \
    && test -d /opt/flagtree-src/.git \
    && git -C /opt/flagtree-src --no-pager log -1 --format='>>> flagtree source: %H %s'

# Build the wheel from source.
#  - PYTHONPATH is dropped: /etc/profile.d/zz-compiler.sh puts the VENDOR flagtree
#    (/opt/flagtree) on it in every bash shell, so the build and the smoke test
#    would import that wheel instead of the tree being built.
#  - --no-build-isolation: build against the venv's pins above.
#  - TRITON_APPEND_CMAKE_ARGS force-includes <cstdint>: FlagPrism's Metric.h uses
#    uint64_t with only <variant>/<vector>, and FlagPrism is on by default for
#    this backend, so every one of its translation units fails (run 35205974671).
#    setup.py shlex-splits it onto cmake's own command line (setup.py:558), so the
#    value must be a -D argument, not a compiler flag.
#  - .git is removed before `pip wheel`: see FLAGTREE_BASE_VERSION above.
#  - The proxy probe is repeated here: this step fetches flir / FlagPrism /
#    AscendNPU-IR through FlagTree's own tooling, which inherits this shell.
RUN unset PYTHONPATH \
    && cd /opt/flagtree-src \
    && unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY no_proxy NO_PROXY all_proxy ALL_PROXY \
    && if timeout 30 git ls-remote https://github.com/flagos-ai/flagtree HEAD >/dev/null 2>&1; then \
         echo ">>> github reachable directly, no proxy"; \
       elif [ -n "${PROXY_URL}" ]; then \
         export http_proxy="${PROXY_URL}" https_proxy="${PROXY_URL}" \
                no_proxy="${PROXY_NO_PROXY}" NO_PROXY="${PROXY_NO_PROXY}"; \
         echo ">>> github not directly reachable, using the relayed proxy"; \
       else \
         echo ">>> github not directly reachable and no proxy was relayed" >&2; exit 1; \
       fi \
    && PIP_INDEX_URL="${EXTRA_PYPI}" pip install --no-cache-dir -r python/requirements.txt \
    && pip install --no-cache-dir "pybind11==${PYBIND11_VERSION}" "nanobind==${NANOBIND_VERSION}" \
    && _ver="${FLAGTREE_WHEEL_VERSION:-${FLAGTREE_BASE_VERSION}.$(date -u +%Y%m%d)}" \
    && echo ">>> wheel version: ${_ver}" \
    && export FLAGTREE_BACKEND=ascend FLAGTREE_WHEEL_VERSION="${_ver}" \
    && export TRITON_APPEND_CMAKE_ARGS='-DCMAKE_CXX_FLAGS="-include cstdint"' \
    && export PATH="/root/.flagtree/ascend/${LLVM_DIR}/bin:${PATH}" \
    && clang --version \
    && rm -rf /opt/flagtree-src/.git \
    && for i in 1 2 3; do \
         MAX_JOBS="${MAX_JOBS}" pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# Fail the build, and therefore the publish, on a wheel the ascend backends cannot
# use. A COPYed script rather than a heredoc: the CANN nodes run Docker's legacy
# builder, which has no heredoc support.
COPY verify_ascend_wheel.py /tmp/
RUN CANN_VERSION="${CANN_VERSION}" python3 /tmp/verify_ascend_wheel.py

# Install the fresh wheel into a directory of its own and import it: PYTHONPATH
# keeps the import off the vendor flagtree, and the assertions prove what got
# imported is this wheel. No NPU device is needed. The version is read off the
# file name (longest match: the tag is "-cp311-cp311-linux_aarch64", and the
# shortest match would stop after the first cp311).
RUN whl="$(basename /wheels/*.whl)" \
    && ver="${whl#flagtree-}" && ver="${ver%%-cp311-*}" \
    && rm -rf /opt/wheel-test \
    && pip install --no-cache-dir --no-deps --target /opt/wheel-test /wheels/*.whl \
    && PYTHONPATH=/opt/wheel-test WHEEL_VER="${ver}" python3 -c "\
import importlib.metadata as md, os, triton;\
from triton.backends import backends;\
ver = os.environ['WHEEL_VER'];\
assert triton.__file__.startswith('/opt/wheel-test'), triton.__file__;\
assert 'ascend' in backends, sorted(backends);\
assert md.version('flagtree') == ver, (md.version('flagtree'), ver);\
print('OK flagtree', md.version('flagtree'), 'triton', triton.__version__, 'backends', sorted(backends))"
