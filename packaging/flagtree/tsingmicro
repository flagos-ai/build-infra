# Build a FlagTree tsingmicro (Tsingmicro TX8) wheel on Ubuntu 22.04 (glibc 2.35,
# gcc 11.4) with the 22.04 system python 3.10, which is the interpreter the
# backend's runtime pins. The runtime is 24.04, and building for 22.04 only has
# to import there -- the direction glibc compatibility runs in.
#   docker build --target builder -t flagtree-builder-tsingmicro:ci -f tsingmicro .
#   docker build -t flagtree-tsingmicro:0.7.0 -f tsingmicro .

ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

# Proxy is consumed during build only -- an ARG is not persisted in the image.
# no_proxy is declared too: an undeclared ARG of that name is not inherited.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The prebuilt inputs, staged on our own filestore: ks3 answers the CI proxy with
# 500. The names are FlagTree's own cache keys -- tsingmicro.py declares
# `tsingmicro-llvm22` and `tx8_deps`, and re-downloads a cache whose key it does
# not recognize, so both directories are staged under exactly those names and
# the vendor's tarball roots are renamed to match.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG LLVM_TARBALL=tsingmicro-llvm22-x64_v0.6.1.tar.gz
ARG LLVM_KEY=tsingmicro-llvm22
ARG TX8_TARBALL=tx8_depends_v0.6.1.tar.gz
ARG TX8_KEY=tx8_deps
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz

ENV DEBIAN_FRONTEND=noninteractive

# The marker is written last: on top of a published builder every line below is
# already in the image, and the guard is what skips it. No clang is installed:
# FlagTree selects clang for this backend and the staged LLVM is the only one it
# may resolve, so an apt clang would be a second, silently-chosen compiler.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates git wget curl binutils \
        build-essential cmake ninja-build \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        python3.10 python3.10-dev python3.10-venv python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && printf '[global]\nindex-url = https://mirrors.aliyun.com/pypi/simple/\n' > /etc/pip.conf \
    && python3.10 -m pip install --no-cache-dir --upgrade pip wheel setuptools \
    && mkdir -p /root/.flagtree/tsingmicro /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${TX8_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           wget -q --tries=3 --timeout=60 "${DEPS_BASE}/${f}" -O "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && mkdir -p "/root/.flagtree/tsingmicro/${LLVM_KEY}" "/root/.flagtree/tsingmicro/${TX8_KEY}" \
    && tar -xzf "${LLVM_TARBALL}" -C "/root/.flagtree/tsingmicro/${LLVM_KEY}" --strip-components=1 \
    && tar -xzf "${TX8_TARBALL}" -C "/root/.flagtree/tsingmicro/${TX8_KEY}" --strip-components=1 \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -x "/root/.flagtree/tsingmicro/${LLVM_KEY}/bin/clang" \
    && test -f "/root/.flagtree/tsingmicro/${LLVM_KEY}/bin/FileCheck" \
    && test -f "/root/.flagtree/tsingmicro/${LLVM_KEY}/lib/cmake/mlir/MLIRConfig.cmake" \
    && test -f "/root/.flagtree/tsingmicro/${LLVM_KEY}/lib/cmake/lld/LLDConfig.cmake" \
    && test -f "/root/.flagtree/tsingmicro/${TX8_KEY}/rcs1fw-rtt/rcsfw_include_interface.cmake" \
    && test -d "/root/.flagtree/tsingmicro/${TX8_KEY}/profiling_tool/lib" \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && test -d /root/.triton/nvidia/cudart \
    && test -d /root/.triton/nvidia/cupti \
    && touch /opt/flagtree-build-env.ready

# --strip-components=1 on the LLVM and the tx8 deps is what renames them onto
# FlagTree's cache keys: both tarballs are rooted at a directory of the vendor's
# choosing (`tsingmicro-llvm22/`, `tx8_deps/`), and the cache directory name is
# what `check_file` matches. The triton toolkits tarball is rooted at `.triton/`
# for the same reason, and unstripped it lands one level below what FlagTree reads.

# LLVM_SYSPATH and TX8_DEPS_ROOT are deliberately NOT set: tsingmicro.py's two
# cache entries each short-circuit on one of them (pre_hook=check_env(...)), so
# setting either bypasses the staged tree and sends the build to the vendor's ks3
# bucket. Their post_hooks are what export the paths and the mlir_core PYTHONPATH
# -- staging without the variables is what lets them run.

# The RISC-V crt and the profiler are compiled with an absolute
# ${LLVM_SYSPATH}/bin/clang, but the top-level project gets the bare name `clang`,
# so the staged bin has to reach cmake through PATH -- which is why no apt clang
# is installed above.

FROM builder AS flagtree

# Stage-scoped, so every arg the wheel build reads is declared again. BuildKit
# inherits a parent stage's ARGs into a `FROM parent` child and the legacy
# builder does not, so an ARG declared only above is empty on half the runners.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# FlagTree ref, the single version knob; the backend is selected at build time via
# FLAGTREE_BACKEND, not by source. The default is the release configs.yaml pins for
# tsingmicro-tsm260610 -- a client installs this wheel's version, so the two must
# not drift. A daily run overrides it.
ARG FLAGTREE_VERSION=0.7.0+tsingmicro3.6

# Wheel version, defaulting to the ref so one arg drives both. FlagTree appends a
# dirty "+git<sha>" unless it holds the vendor's FLAGTREE_PYPI_KEY or finds no
# .git dir, so the build removes .git before `pip wheel`.
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=

# The two staged trees, reaching this stage by name so cmake's bare-`clang`
# selection resolves to the same compiler the crt and profiler link with.
ARG LLVM_KEY=tsingmicro-llvm22
ARG TX8_KEY=tx8_deps

# No pybind11 pin: tsingmicro.py ships no internals table and no prebuilt .so is an
# ABI counterparty -- every binding in this wheel is compiled here from one
# pybind11, so there is nothing for a pin to agree with. The gate asserts what that
# leaves unstated: that libtriton.so and the build's pybind11 agree on the ABI.
ARG MAX_JOBS=32

# THE SHA IS READ BEFORE .git GOES, AND BOTH BEFORE `pip wheel`: the version has
# to come out clean, so .git must not exist when setup.py asks, while the commit
# id is worth keeping, so it goes into a setup.cfg that setuptools merges into
# setup() on its own. FlagTree ships no setup.cfg of its own, so its absence is
# asserted rather than assumed.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         git clone --branch "${FLAGTREE_VERSION}" --depth 1 \
           https://github.com/flagos-ai/flagtree /opt/flagtree && break; \
         echo ">>> flagtree clone attempt $i failed, retrying in 5s..."; \
         rm -rf /opt/flagtree; sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && if [ -e /opt/flagtree/setup.cfg ]; then \
         echo "ERROR: FlagTree now ships its own setup.cfg, which would be" >&2; \
         echo "       overwritten below. Move the carrier to that file instead." >&2; \
         exit 1; \
       fi \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && cd /opt/flagtree \
    && python3.10 -m pip install --no-cache-dir -r python/requirements.txt \
    && export FLAGTREE_BACKEND=tsingmicro \
    && export TRITON_APPEND_CMAKE_ARGS="-DCMAKE_BUILD_TYPE=Release" \
    && export PATH="/root/.flagtree/tsingmicro/${LLVM_KEY}/bin:${PATH}" \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export MAX_JOBS="${MAX_JOBS}" \
    && clang --version \
    && rm -rf /opt/flagtree/.git \
    && for i in 1 2 3 4 5; do \
         python3.10 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# printf to a file, not `python - <<'PY'`: on Docker's legacy builder a heredoc
# never reaches python's stdin and the step passes having asserted nothing.
# The three vendored artifacts are asserted because install_extension only WARNS
# when the CMake build tree did not produce one -- a wheel missing tsingmicro-opt
# is unloadable and would otherwise be published.
RUN printf '%s\n' \
      'import glob, os, re, subprocess, sys, tempfile, zipfile' \
      '' \
      'whl = glob.glob("/wheels/*.whl")[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if "git" in ver:' \
      '    print("FAIL: dirty wheel version " + ver + " (expected clean, no git-sha suffix)")' \
      '    sys.exit(1)' \
      'if "cp310" not in name:' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp310)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name + " version " + ver)' \
      '' \
      'd = tempfile.mkdtemp()' \
      'zf = zipfile.ZipFile(whl)' \
      'zf.extractall(d)' \
      'for p in ("triton/backends/tsingmicro/__init__.py", "triton/backends/tsingmicro/compiler.py"):' \
      '    if not os.path.exists(os.path.join(d, p)):' \
      '        print("FAIL: " + name + " ships no " + p + " (wrong FLAGTREE_BACKEND?)")' \
      '        sys.exit(1)' \
      'print("OK: wheel ships the tsingmicro backend package")' \
      '' \
      'artifacts = {' \
      '    "triton/backends/tsingmicro/bin/tsingmicro-opt": 10_000_000,' \
      '    "triton/backends/tsingmicro/bin/tx-profiler": 100_000,' \
      '    "triton/backends/tsingmicro/lib/libvr.a": 10_000,' \
      '}' \
      'for p, floor in artifacts.items():' \
      '    f = os.path.join(d, p)' \
      '    size = os.path.getsize(f) if os.path.exists(f) else -1' \
      '    if size < floor:' \
      '        print("FAIL: " + p + " is " + str(size) + " bytes (want >= " + str(floor) + "); install_extension skipped it")' \
      '        sys.exit(1)' \
      'print("OK: wheel ships tsingmicro-opt, tx-profiler and libvr.a")' \
      '' \
      'so = os.path.join(d, "triton", "_C", "libtriton.so")' \
      'if not os.path.exists(so):' \
      '    print("FAIL: no triton/_C/libtriton.so in " + name)' \
      '    sys.exit(1)' \
      'syms = subprocess.check_output(["objdump", "-T", so], text=True)' \
      'forbidden = ["GLIBC_2.38", "GLIBCXX_3.4.31", "GLIBCXX_3.4.32", "__isoc23_"]' \
      'hits = [f for f in forbidden if f in syms]' \
      'if hits:' \
      '    print("FAIL: 22.04-incompatible symbols in libtriton.so: " + str(hits))' \
      '    sys.exit(1)' \
      'maxglibc = max(set(re.findall(r"GLIBC_[0-9.]+", syms)), key=lambda v: [int(x) for x in v[6:].split(".")])' \
      'print("OK: libtriton.so is 22.04-clean (max " + maxglibc + ", no forbidden symbols)")' \
      '' \
      'import pybind11' \
      'hdr = os.path.join(pybind11.get_include(), "pybind11", "detail", "internals.h")' \
      'm = re.search(r"#\s*define\s+PYBIND11_INTERNALS_VERSION\s+(\d+)", open(hdr).read())' \
      'if not m:' \
      '    print("FAIL: no PYBIND11_INTERNALS_VERSION in " + hdr)' \
      '    sys.exit(1)' \
      'want = m.group(1).encode()' \
      'tagged = lambda p: sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", open(p, "rb").read())))' \
      'sos = sorted(glob.glob(d + "/triton/_C/*.so"))' \
      'bad = {os.path.basename(p): tagged(p) for p in sos if tagged(p) and tagged(p) != [want]}' \
      'if tagged(so) != [want] or bad:' \
      '    print("FAIL: pybind11 internals " + str(tagged(so)) + " in libtriton.so, " + str(bad) + " elsewhere; the build installed pybind11 " + pybind11.__version__ + " which provides v" + want.decode())' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so and every tagged .so in _C carry pybind11 internals v" + want.decode() + ", matching the build pybind11 " + pybind11.__version__)' \
    > /tmp/gate.py \
    && python3.10 /tmp/gate.py

# NO IMPORT SMOKE TEST HERE, unlike every other builder in this directory. The
# backend's driver.py imports torch_txda at module level, `import triton` reaches
# it through backend discovery, and torch_txda aborts at import unless it is
# linked against the vendor profiler and handed the TX8 device nodes -- neither of
# which a docker build can have. What an import proves is asserted on the
# backend's own node; what a build can still prove is that the wheel INSTALLS and
# keeps the vendored artifacts, which is the part package_data could silently drop.
RUN python3.10 -m pip install --no-cache-dir --no-deps --target /opt/wheel-test /wheels/*.whl \
    && test -x /opt/wheel-test/triton/backends/tsingmicro/bin/tsingmicro-opt \
    && test -x /opt/wheel-test/triton/backends/tsingmicro/bin/tx-profiler \
    && ar t /opt/wheel-test/triton/backends/tsingmicro/lib/libvr.a > /dev/null \
    && python3.10 -c "\
import glob, os, zipfile;\
whl = glob.glob('/wheels/*.whl')[0];\
zf = zipfile.ZipFile(whl);\
meta = next(n for n in zf.namelist() if n.endswith('.dist-info/METADATA'));\
lines = zf.read(meta).decode().splitlines();\
urls = [l for l in lines if l.startswith('Project-URL: Source-Commit, ')];\
assert len(urls) == 1 and urls[0].startswith('Project-URL: Source-Commit, https://github.com/flagos-ai/flagtree/commit/'), urls;\
ver = [l.split(': ', 1)[1] for l in lines if l.startswith('Version: ')][0];\
assert 'git' not in ver, ver;\
print('OK: wheel installs the vendored artifacts;', urls[0])"
