# Build a FlagTree sunrise (PTPU) wheel on Ubuntu 22.04 (glibc 2.35 / clang 14):
# the vendor's wheel is built on 24.04 and drags GLIBC_2.38 + GLIBCXX_3.4.32 into
# libtriton.so, which a 22.04 client cannot load. Build:
#   docker build -t flagtree-sunrise:0.7.0 -f sunrise .
# Extract: id=$(docker create flagtree-sunrise:0.7.0); docker cp $id:/wheels ./wheels

# TWO STAGES, ONE FILE. `--target builder` is the build machine (apt toolchain,
# python 3.10, the three prebuilt sunrise inputs), published by
# flagtree-builder.yml; the default target builds the wheel on top of it. It is
# also the one knob that separates a cold build from a warm one -- pointing this
# at the published stage turns everything below it into a no-op, via its marker.
ARG BUILDER_IMAGE=ubuntu:22.04
FROM ${BUILDER_IMAGE} AS builder

# Proxy is consumed during build only -- an ARG is not persisted in the image.
# no_proxy is declared too: an undeclared ARG of that name is not inherited.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# The prebuilt backend inputs, staged on our own filestore: ks3 answers the CI
# proxy with 500. The names are upstream's -- FlagTree declares them in
# python/setup_tools/utils/sunrise.py and re-downloads what it does not recognize
# -- and the plugin .so is md5-gated below.
ARG DEPS_BASE=https://resource.flagos.net/repository/flagos-filestore/flagtree-deps
ARG LLVM_TARBALL=llvm-71bd243f-triton-v3.6.x.tar.gz
ARG PLUGIN_TARBALL=sunriseTritonPlugin_v0.6.0.4.tar.gz
ARG TRITON_DEPS_TARBALL=build-deps-triton_3.6.x-linux-x64.tar.gz
# The LLVM/plugin tarballs unpack to /root/.flagtree/sunrise/<cache key>, which is
# how FlagTree's cache resolves them by name; the triton toolkits tarball is rooted
# at `.triton/` and needs the --strip-components=1 below.

ENV DEBIAN_FRONTEND=noninteractive

# The marker is written last: on top of a published builder every line below is
# already in the image, and the guard is what skips it. clang/lld 14 with the
# unversioned symlinks setup.py and -fuse-ld=lld look for -- the bare `lld` driver
# only prints usage and exits 1 on --version, so ld.lld is the one worth checking.
RUN set -eu; \
    if [ -f /opt/flagtree-build-env.ready ]; then \
        echo ">>> build environment already staged in the base image"; \
        exit 0; \
    fi; \
    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git wget curl binutils \
        build-essential cmake ninja-build \
        clang-14 lld-14 \
        zlib1g zlib1g-dev libxml2 libxml2-dev nlohmann-json3-dev \
        libncurses5-dev libncursesw5-dev libgdbm-dev libnss3-dev \
        libssl-dev libreadline-dev libffi-dev libsqlite3-dev \
        libdb5.3-dev libbz2-dev libexpat1-dev liblzma-dev \
        python3.10 python3.10-dev python3.10-venv python3-pip \
    && ln -sf /usr/bin/clang-14 /usr/bin/clang \
    && ln -sf /usr/bin/clang++-14 /usr/bin/clang++ \
    && ln -sf /usr/bin/lld-14 /usr/bin/lld \
    && ln -sf /usr/bin/ld.lld-14 /usr/bin/ld.lld \
    && clang++ --version && ld.lld --version \
    && rm -rf /var/lib/apt/lists/* \
    && printf '[global]\nindex-url = https://mirrors.aliyun.com/pypi/simple/\n' > /etc/pip.conf \
    && python3.10 -m pip install --no-cache-dir --upgrade pip wheel setuptools \
    && mkdir -p /root/.flagtree/sunrise /root/.triton \
    && cd /tmp \
    && for f in "${LLVM_TARBALL}" "${PLUGIN_TARBALL}" "${TRITON_DEPS_TARBALL}"; do \
         for i in 1 2 3 4 5; do \
           wget -q --tries=3 --timeout=60 "${DEPS_BASE}/${f}" -O "${f}" && break; \
           echo ">>> download ${f} attempt $i failed, retrying in 10s..."; sleep 10; \
         done; \
       done \
    && tar -xzf "${LLVM_TARBALL}"    -C /root/.flagtree/sunrise \
    && tar -xzf "${PLUGIN_TARBALL}"  -C /root/.flagtree/sunrise \
    && tar -xzf "${TRITON_DEPS_TARBALL}" -C /root/.triton --strip-components=1 \
    && rm -f /tmp/*.tar.gz \
    && test -d /root/.flagtree/sunrise/sunrise_llvm22_dev_release/stpu/bitcode \
    && test -f /root/.flagtree/sunrise/sunriseTritonPlugin.so \
    && echo "4c77b8c0a71ddc377bbcfb1024114fc1  /root/.flagtree/sunrise/sunriseTritonPlugin.so" | md5sum -c - \
    && test -f /root/.triton/json/include/nlohmann/json.hpp \
    && touch /opt/flagtree-build-env.ready

FROM builder AS flagtree

# Stage-scoped, so every arg the wheel build reads is declared again: ARGs do not
# carry across FROM, while the stage's filesystem and ENV do. The proxy args are
# here because this stage clones the source and pip-installs.
ARG http_proxy=
ARG https_proxy=
ARG no_proxy=

# FlagTree ref, the single version knob, defaulting to the release configs.yaml
# pins so a client's version cannot drift from it. Branch, tag or sha: the fetch
# below is not `clone --branch`, which cannot take a sha.
ARG FLAGTREE_VERSION=0.7.0+sunrise3.6

# Wheel version, defaulting to the ref so one arg drives both. .git is removed
# before `pip wheel` because FlagTree appends a dirty "+git<sha>" otherwise.
# FLAGTREE_WHEEL_NAME is the distribution name and FLAGTREE_PYPI_KEY the other
# route to a clean version; the daily line sets the name.
ARG FLAGTREE_WHEEL_VERSION=${FLAGTREE_VERSION}
ARG FLAGTREE_WHEEL_NAME=flagtree
ARG FLAGTREE_PYPI_KEY=
# Upstream's own rule, sunrise.py's _PYBIND11_INTERNALS_TO_PIP: the prebuilt
# plugin's pybind11 internals map to exactly pybind11==3.1.0, so the pin is read
# off upstream's table. Declared in this stage, not the builder -- on Docker's
# legacy builder a parent stage's ARG does not carry.
ARG PYBIND11_SPEC=pybind11==3.1.0
ARG MAX_JOBS=32

# clang/lld + proton off + offline are upstream's own settings for this backend,
# and clang is load-bearing rather than cosmetic: cmake's backend flag list omits
# sunrise, so it lands on "-Wno-covered-switch-default" -- clang-only -- and under
# gcc -Werror is fully armed, which gluon_ir.cc's hidden-visibility fields fail.

# THE SHA IS READ BEFORE .git GOES, AND BOTH BEFORE `pip wheel`: the version has
# to come out clean, so .git must not exist when setup.py asks, while the commit
# id is worth keeping, so it goes into a setup.cfg that setuptools merges into
# setup() on its own.
RUN git config --global http.version HTTP/1.1 \
    && for i in 1 2 3 4 5 6 7 8; do \
         rm -rf /opt/flagtree && git init -q /opt/flagtree \
           && git -C /opt/flagtree remote add origin https://github.com/flagos-ai/flagtree \
           && git -C /opt/flagtree fetch --depth 1 origin "${FLAGTREE_VERSION}" \
           && git -C /opt/flagtree checkout -q FETCH_HEAD && break; \
         echo ">>> flagtree fetch attempt $i failed, retrying in 5s..."; \
         sleep 5; \
       done \
    && test -d /opt/flagtree/.git \
    && sha8="$(git -C /opt/flagtree rev-parse --short=8 HEAD)" \
    && printf '[metadata]\nproject_urls =\n    Source-Commit = https://github.com/flagos-ai/flagtree/commit/%s\n' \
         "${sha8}" > /opt/flagtree/setup.cfg \
    && cd /opt/flagtree \
    && python3.10 -m pip install --no-cache-dir -r python/requirements.txt \
    && python3.10 -m pip install --no-cache-dir "${PYBIND11_SPEC}" \
    && ln -sfn ptpu third_party/sunrise/language/tang \
    && export FLAGTREE_BACKEND=sunrise \
    && export FLAGTREE_WHEEL_VERSION="${FLAGTREE_WHEEL_VERSION}" \
    && export FLAGTREE_WHEEL_NAME="${FLAGTREE_WHEEL_NAME}" \
    && export FLAGTREE_PYPI_KEY="${FLAGTREE_PYPI_KEY}" \
    && export TRITON_BUILD_WITH_CLANG_LLD=1 \
    && export TRITON_OFFLINE_BUILD=1 \
    && export TRITON_BUILD_PROTON=OFF \
    && export TRITON_APPEND_CMAKE_ARGS='-DCMAKE_INSTALL_RPATH=$ORIGIN -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON' \
    && export MAX_JOBS="${MAX_JOBS}" \
    && rm -rf /opt/flagtree/.git \
    && for i in 1 2 3 4 5; do \
         python3.10 -m pip wheel . --no-build-isolation --no-deps -w /wheels -v && break; \
         echo ">>> wheel build attempt $i failed, retrying in 10s..."; sleep 10; \
       done \
    && ls -la /wheels/*.whl

# What this build exists for: the cp310 tag its builder was set up for, and a
# libtriton.so a 22.04 client can load. printf to a file, not `python - <<'PY'`:
# on Docker's legacy builder a heredoc never reaches python's stdin and the step
# passes having asserted nothing.
RUN printf '%s\n' \
      'import glob, os, re, subprocess, sys, tempfile, zipfile' \
      '' \
      'whl = glob.glob("/wheels/*.whl")[0]' \
      'name = os.path.basename(whl)' \
      'ver = name.split("-")[1]' \
      'if not name.endswith("-cp310-cp310-linux_x86_64.whl"):' \
      '    print("FAIL: unexpected wheel tag in " + name + " (expected cp310)")' \
      '    sys.exit(1)' \
      'print("OK: wheel " + name + " version " + ver)' \
      '' \
      'd = tempfile.mkdtemp()' \
      'zipfile.ZipFile(whl).extractall(d)' \
      'so = next(p for p in glob.glob(d + "/**/libtriton.so", recursive=True))' \
      'syms = subprocess.check_output(["objdump", "-T", so], text=True)' \
      'glibc = max(tuple(int(x) for x in m) for m in re.findall(r"GLIBC_(\d+)\.(\d+)", syms))' \
      'glibcxx = max(tuple(int(x) for x in m) for m in re.findall(r"GLIBCXX_(\d+)\.(\d+)\.(\d+)", syms))' \
      'if glibc > (2, 35) or glibcxx > (3, 4, 30):' \
      '    print("FAIL: libtriton.so needs GLIBC " + ".".join(map(str, glibc)) + " / GLIBCXX " + ".".join(map(str, glibcxx)) + ", past 22.04")' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so fits 22.04 (max GLIBC " + ".".join(map(str, glibc)) + ", max GLIBCXX " + ".".join(map(str, glibcxx)) + ")")' \
      '' \
      'plugin = "/root/.flagtree/sunrise/sunriseTritonPlugin.so"' \
      'want = sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", open(plugin, "rb").read())))' \
      'got = sorted(set(re.findall(rb"__pybind11_internals_v(\d+)", open(so, "rb").read())))' \
      'if got != want:' \
      '    print("FAIL: libtriton.so pybind11 internals " + str(got) + ", the prebuilt plugin is " + str(want))' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so and sunriseTritonPlugin_v0.6.0.4 share pybind11 internals " + str(got))' \
      '' \
      'extra = os.path.join(d, "triton", "language", "extra")' \
      'missing = [n for n in ("ptpu", "tang") if not os.path.isdir(os.path.join(extra, n))]' \
      'if missing:' \
      '    print("FAIL: wheel missing triton.language.extra." + str(missing) + " (tang alias not picked up)")' \
      '    sys.exit(1)' \
      'print("OK: wheel ships triton.language.extra ptpu + tang")' \
      '' \
      'rp = re.search(r"Library runpath: \[([^\]]*)\]", subprocess.check_output(["readelf", "-d", so], text=True))' \
      'if not (rp and "$ORIGIN" in rp.group(1)):' \
      '    print("FAIL: libtriton.so RUNPATH " + (rp.group(1) if rp else "<none>") + " (expected $ORIGIN)")' \
      '    sys.exit(1)' \
      'print("OK: libtriton.so RUNPATH " + rp.group(1))' \
    > /tmp/gate.py \
    && python3.10 /tmp/gate.py

# Smoke test: install the freshly built wheel, import it, and assert the two
# things the version pin and the setup.cfg carrier are for.
RUN python3.10 -m pip install --no-cache-dir /wheels/*.whl \
    && python3.10 -c "\
import importlib.metadata as md, triton;\
from triton.backends import backends;\
print('OK', md.version('${FLAGTREE_WHEEL_NAME}'), 'triton', triton.__version__, 'backends', list(backends.keys()));\
urls = md.metadata('${FLAGTREE_WHEEL_NAME}').get_all('Project-URL') or [];\
print('OK', [u for u in urls if u.startswith('Source-Commit')]);\
assert any(u.startswith('Source-Commit, https://github.com/flagos-ai/flagtree/commit/') for u in urls), urls;\
assert md.version('${FLAGTREE_WHEEL_NAME}') == '${FLAGTREE_WHEEL_VERSION}', md.version('${FLAGTREE_WHEEL_NAME}')"
