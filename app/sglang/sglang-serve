# ============================================================================
# sglang-serve — the single serve command for the sglang app image.
#
# Sources the baked vendor env (full CANN / MACA LD_LIBRARY_PATH lives in
# /etc/profile.d, NOT in the image ENV — a plain
# `docker run <image> /flagos/bin/python ...` bypasses bash and misses it),
# then execs sglang's server with the caller's arguments passed through
# verbatim. sglang 0.5.18 takes the model as --model-path/--model (no
# positional model argument — unlike vllm's --model this is the only form).
#
#   docker run <image> sglang-serve --model-path /data/models/Qwen/Qwen3-0.6B --port 8032
#   docker run <image> sglang-serve --help
#
# Re-sourcing is safe: the profile.d scripts are idempotent, and vendor.sh
# (where present) assigns PATH absolutely, so no prepend accumulates.
# ============================================================================

set -euo pipefail
[ -r /etc/bash_env.sh ] && . /etc/bash_env.sh
# sglang takes the watchdog only as the --watchdog-timeout CLI flag (no env).
# cambricon bakes SGLANG_WATCHDOG_TIMEOUT=900 (env.app.sglang) so a cold
# `docker run ... sglang-serve ...` survives the ~15min flag_gems autotune
# instead of dying on the 300s default. Prepended so a caller's own
# --watchdog-timeout (later in argv) still wins.
if [[ -n "${SGLANG_WATCHDOG_TIMEOUT:-}" ]]; then
    set -- --watchdog-timeout "${SGLANG_WATCHDOG_TIMEOUT}" "$@"
fi
exec /flagos/bin/python -m sglang.launch_server "$@"
