# ============================================================
# FlagOS sglang app image
#
# Single Containerfile for all backends — build args drive the
# per-vendor configuration.  See packaging/sglang/docs/sglang-0.5.18/
# (playbook.md) for the full guide.
#
# Revision history:
#   2026-09-02   Initial version. sglang from the repacked srt_empty wheel
#                (vendor PyPI, +flagos pin) — the zero-torch, zero-sgl-kernel
#                base that leaves the runtime's torch/triton/flag_gems matrix
#                untouched (playbook §2). Plugin + sgl_kernel shim install
#                from vendor PyPI wheels when their versions are supplied.
#   2026-09-02   sglang-serve launcher (COPY + CMD default): sources the baked
#                vendor env before exec'ing sglang's server, so a plain
#                `docker run <image>` works.
# TODO
#   - Publish-time verification (torch version, sglang import).
# ============================================================

ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}

# --- Build arguments ------------------------------------------

ARG SGLANG_VERSION=0.5.18

# Repacked sglang wheel lives here — searched first.
ARG FLAGOS_PYPI=""

# Fallback for all other dependencies.
ARG EXTRA_PYPI="https://mirrors.aliyun.com/pypi/simple"

# sglang-plugin-FL wheel version (e.g. "0.2.0rc0.post2.dev11+gb9e835e85") —
# the setuptools-scm tag+commit encoding, so wheel == exact plugin commit. The
# sglang-plugin-wheel workflow builds + audits it and the wheel is installed
# from the vendor PyPI; nothing is built from source here. Empty = the wheel is
# not on the index yet (verify builds it in-container from exp/0.5.18) — leave
# empty until the publication workflow has run, then pin the commit-precise
# version.
ARG PLUGIN_FL_VERSION=""

# Zero-sgl-kernel import-face shim: sglang imports `sgl_kernel`
# unconditionally (playbook §5.2) but the srt_empty wheel ships no dep on it,
# so the app image carries the generic backend-agnostic shim from the vendor
# PyPI. The version tracks sglang (0.5.18 -> 0.5.18+flagos-shim); override
# with SHIM_VERSION='' to skip (pre-publication debug only).
ARG SHIM_VERSION="${SGLANG_VERSION}+flagos-shim"

# Vendor-conditional app-level deps (configs.yaml deps_app.sglang0.5.18),
# installed after the plugin/shim. Some backends need a package in the app
# layer that is not in the runtime matrix.
ARG APP_DEPS=""

# --- Install sglang (repacked wheel) --------------------------

# The vendor PyPI carries the repacked wheel as sglang-{version}+flagos. The
# +flagos pin is mandatory: a bare "sglang=={version}" would fall through to
# the official wheel on the fallback index, whose torch Requires-Dist would
# pull a generic torch over the runtime's pinned vendor torch. The srt_empty
# base's METADATA is audited torch-free and sgl-kernel-free (playbook §2/§4),
# so this install cannot touch the baked matrix.
RUN pip install \
  --index-url "${FLAGOS_PYPI}" \
  --extra-index-url "${EXTRA_PYPI}" \
  "sglang==${SGLANG_VERSION}+flagos"

# --- Install the sglang_fl plugin (wheel) --------------------

# Clean single-step install of the audited plugin wheel — same index pair as
# sglang. The plugin auto-loads via its sglang.srt entry points, so no env var
# turns it on (unlike vllm's VLLM_PLUGINS).
RUN if [ -n "${PLUGIN_FL_VERSION}" ]; then \
    pip install \
      --index-url "${FLAGOS_PYPI}" \
      --extra-index-url "${EXTRA_PYPI}" \
      "sglang-fl==${PLUGIN_FL_VERSION}" ; \
  fi

# --- Install the sgl_kernel import-face shim (wheel) ---------

# Same index pair + version-pin discipline as the plugin. Distribution name is
# `sgl_kernel` (pip-canonical `sgl-kernel`); the shim source is the
# sglang-plugin-FL addon (playbook §5.2), published by the sglang-wheel
# workflow's shim job.
RUN if [ -n "${SHIM_VERSION}" ]; then \
    pip install \
      --index-url "${FLAGOS_PYPI}" \
      --extra-index-url "${EXTRA_PYPI}" \
      "sgl-kernel==${SHIM_VERSION}" ; \
  fi

# --- App env --------------------------------------------------

# Per-backend app env vars (configs.yaml env.app.sglang, e.g. the ascend
# USE_FLAGGEMS=0 that keeps flag_gems.enable() away from torch_npu, and the
# SGLANG_SWITCHES the verify exports): baked into /etc/profile.d/app_env.sh —
# sourced by the runtime's bash plumbing (BASH_ENV=/etc/bash_env.sh sources
# /etc/profile.d/*.sh). Each line is prefixed with 'export ' so the vars
# survive the launcher's exec — a bare KEY=value assignment dies with the
# sourcing shell and never reaches the exec'd server.
ARG APP_ENV=""
RUN if [ -n "${APP_ENV}" ]; then \
      printf '%s\n' "${APP_ENV}" | sed 's/^/export /' > /etc/profile.d/app_env.sh; \
    fi

# --- Vendor-conditional app deps -----------------------------

RUN if [ -n "${APP_DEPS}" ]; then \
    pip install \
      --index-url "${FLAGOS_PYPI}" \
      --extra-index-url "${EXTRA_PYPI}" \
      ${APP_DEPS} ; \
  fi

# --- Serve launcher -------------------------------------------

# sglang-serve: the single serve command for this image. The full vendor env
# (CANN / MACA LD_LIBRARY_PATH) lives in /etc/profile.d, not in the image ENV
# — a plain `docker run <image> /flagos/bin/python ...` bypasses bash and
# misses it. sglang-serve sources it (idempotent) then execs sglang's server
# (top-level module for 0.5.18, playbook §5.3), passing user args verbatim.
# Default CMD = the reference serve (Qwen3-0.6B, port 8032 — distinct from the
# vllm images' 8031 so both can run on one node); users override with e.g.
# `docker run <image> sglang-serve <model> --port 9000`.
COPY app/sglang/sglang-serve /usr/local/bin/sglang-serve
RUN chmod +x /usr/local/bin/sglang-serve

WORKDIR /workspace
CMD ["sglang-serve", "/data/models/Qwen/Qwen3-0.6B", "--port", "8032", \
  "--mem-fraction-static", "0.6", "--trust-remote-code", \
  "--disable-cuda-graph", "--disable-piecewise-cuda-graph"]
