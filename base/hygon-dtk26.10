# ============================================================
# Base image for Hygon DTK 26.10 on Ubuntu 24.04
# ============================================================
# History:
# - 202601029: Initial version for DTK 26.10.

FROM ubuntu:24.04

LABEL org.opencontainers.image.authors="FlagOS contributors"

# ── Build arguments ────────────────────────────────────────────
ARG FILE_STORE=https://resource.flagos.net/repository/flagos-filestore
ARG SDK_PACKAGE=DTK-26.10-Ubuntu24.04-x86_64.tar.gz
ARG LLVM_PACKAGE=dtk_llvm.run

ENV DEBIAN_FRONTEND=noninteractive

# ── System packages ────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        git vim ca-certificates curl unzip \
        libnuma1 \
        libgfortran5 libdrm-amdgpu1 libdw1 libelf1 libpciaccess0 \
        libgoogle-glog0v6t64 \
        gcc g++ build-essential cmake \
        pciutils \
    && rm -rf /var/lib/apt/lists/*

# ── Install DTK ────────────────────────────────────────────────
RUN curl --retry 5 --retry-delay 5 --retry-all-errors -o /dtk.tar.gz ${FILE_STORE}/hygon/${SDK_PACKAGE} \
    && tar xzf /dtk.tar.gz -C /opt \
    && ln -sf /opt/dtk-26.04 /opt/dtk \
    && rm /dtk.tar.gz

# ── Install LLVM DTK ───────────────────────────────────────────
RUN curl --retry 5 --retry-delay 5 --retry-all-errors -o /llvm.run  ${FILE_STORE}/hygon/${LLVM_PACKAGE} \
    && bash /llvm.run --dtk_dir /opt/dtk-26.04 \
    && rm /llvm.run

# ── Capture vendor SDK env into profile.d ──────────────────────
# NOTE: The /opt/dtk-26.10/env.sh needs to be sourced before using
# Users and downstream Dockerfiles no longer need to source env.sh.
# env.sh uses BASH_SOURCE[0] to detect DTKROOT.
SHELL ["/bin/bash", "-c"]
RUN env_before=$(env | sort) && \
    set -a && . /opt/dtk/env.sh > /dev/null 2>&1 || true && set +a && \
    env_after=$(env | sort) && \
    printf '%s\n' "$env_before" > /tmp/_v_before && \
    printf '%s\n' "$env_after" > /tmp/_v_after && \
    comm -13 /tmp/_v_before /tmp/_v_after \
      | grep -v '^_\|^PWD=\|^SHLVL=\|^OLDPWD=' \
      | while IFS='=' read -r var val; do \
          printf 'export %s="%s"\n' "$var" "$val"; \
        done \
      > /etc/profile.d/vendor.sh && \
    rm -f /tmp/_v_before /tmp/_v_after && \
    echo "vendor.sh: captured $(wc -l < /etc/profile.d/vendor.sh) env vars"

# ── Bash plumbing — make profile.d/*.sh available everywhere ─────
RUN printf 'for f in /etc/profile.d/*.sh; do [ -r "$f" ] && . "$f"; done\n' \
    > /etc/bash_env.sh; \
    printf '. /etc/bash_env.sh\n%s' "$(cat /etc/bash.bashrc)" > /etc/bash.bashrc
ENV BASH_ENV=/etc/bash_env.sh

SHELL ["/bin/sh", "-c"]
