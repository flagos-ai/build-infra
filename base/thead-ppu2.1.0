# Base image for T-Head PPU 2.1.0 on Ubuntu 24.04.
#
# Vendored, not installed: the only PPU SDK T-Head ships us is baked into their
# PAI-DSW training image (~25 GB, Aliyun in-country only) — no installer, no
# tarball. So we take that image verbatim and fix the two things that stop it
# being a base. It already carries PPU_SDK v2.1.0 at /usr/local/PPU_SDK
# (ppu-smi, CUDA-compat headers, HGGC 13.3) and no torch/triton — the runtime
# venv owns the Python stack, as on every backend.

FROM youyu-registry.cn-wulanchabu.cr.aliyuncs.com/train/torch:pai-dsw

LABEL org.opencontainers.image.authors="FlagOS contributors"

ENV DEBIAN_FRONTEND=noninteractive

# The vendor image's ENTRYPOINT is /home/pai/bin/entrypoint, a DSW harness that
# re-execs CMD; FlagOS images are entered directly, so clear it.
ENTRYPOINT []
CMD ["bash"]

# Repoint pip off the baked-in Aliyun PAI platform index, so a bare
# `pip install` (runtime's pip upgrade, downstream apps) doesn't resolve there.
ENV PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# Vendor image ships the compiler but not cmake; the app layer and C++ extension
# builds need it. libpython3-dev covers extensions against the vendor python.
# libjpeg-turbo8 provides libjpeg.so.8, which torchvision's image.so links for
# torchvision.io JPEG codecs (libpng16 is already in the vendor image); without
# it torchvision imports with a "Failed to load image extension" warning.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      cmake libpython3-dev libjpeg-turbo8 libpng16-16t64 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
