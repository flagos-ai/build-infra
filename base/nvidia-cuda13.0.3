# ============================================================
# Base image for NVIDIA CUDA 13.0.3 on Ubuntu 24.04
# ============================================================
# Note:
# - The image has builtin python 3.12
# History:
# - 20261120: Initial version — 13.0.3 rather than 13.3, so the toolkit is the
#   major.minor the cu130 wheels (torch 2.13.0+cu130 and the third-party
#   dependencies vLLM pulls in) were actually compiled against.

FROM nvcr.io/nvidia/cuda:13.0.3-runtime-ubuntu24.04

LABEL org.opencontainers.image.authors="FlagOS contributors"

# ── Build arguments ────────────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive

# base dependencies
# Unlike the 13.3.0 NGC runtime image, this one preinstalls `libnccl2` and
# already holds it (2.28.3-1+cuda13.0 at the time of writing) — so nothing is
# installed or re-pinned here. Re-pinning it would mean
# `--allow-change-held-packages`, i.e. fighting the vendor's own hold for a
# version it did not choose; the shipped one is already on the +cuda13.0 track.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      curl unzip git vim ca-certificates libnuma1 libelf1 \
      gcc g++ cmake make build-essential libpython3-dev \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
