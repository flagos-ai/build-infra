# ============================================================
# Base image for Iluvatar Corex 4.5.0 on Ubuntu 24.04
# ============================================================
# History:
# - 20260828: Initial version
FROM ubuntu:24.04 AS builder

LABEL org.opencontainers.image.authors="FlagOS contributors"

# ── Build arguments ────────────────────────────────────────────
ENV FILE_STORE=https://resource.flagos.net/repository/flagos-filestore
ARG SDK_INSTALLER=corex-installer-linux64-4.5.0.20260804_x86_64_10.2.run
ARG DRIVER_INSTALLER=corex-driver-linux64-4.5.0.20260804_x86_64.run
ARG CUDA_HEADER=cuda-header-260604.zip
ARG CMAKE_PKG=cmake-3.31.8+corex.4.5.0.20260804-linux-x86_64.sh

ARG DEBIAN_FRONTEND=noninteractive

# ── System packages ────────────────────────────────────────────
# corex 4.5.0 ships libnvshmem_host.so (NEEDs libmpi.so.40) but no
# OpenMPI; torch 2.10.0+corex links torch_nvshmem -> it, so torch
# import fails without libmpi.so.40. Ubuntu's OpenMPI 4.1.x provides
# the same SONAME.
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl unzip git vim ca-certificates \
        build-essential gcc g++ libopenmpi3t64 \
    && rm -rf /var/lib/apt/lists/*

# Install CUDA header
RUN curl -o /cuda-header.zip ${FILE_STORE}/iluvatar/${CUDA_HEADER} \
    && unzip /cuda-header.zip -d /tmp \
    && bash /tmp/partial_install_cuda_header/install-cuda-header.sh \
    && rm -fr /tmp/partial_install_cuda_header \
    && rm /cuda-header.zip

# Install SDK
RUN curl -o corex-installer.run ${FILE_STORE}/iluvatar/${SDK_INSTALLER} \
  && bash /corex-installer.run --silent --toolkit \
  && rm /corex-installer.run

# Install driver userspace (libcuda/libixml/ixsmi); kernel module can't load in-container
RUN curl -o /corex-driver.run ${FILE_STORE}/iluvatar/${DRIVER_INSTALLER} \
  && bash /corex-driver.run --noexec --target /tmp/drv >/dev/null \
  && mkdir -p /usr/local/corex/lib /usr/local/corex/bin \
  && cp /tmp/drv/corex/lib64/libcuda.so.1 /usr/local/corex/lib/ \
  && cp /tmp/drv/corex/lib64/libixml.so /usr/local/corex/lib/ \
  && cp /tmp/drv/corex/bin/ixsmi /usr/local/corex/bin/ \
  && ln -s libcuda.so.1 /usr/local/corex/lib/libcuda.so \
  && rm -rf /tmp/drv /corex-driver.run

# Install Corex CMake
# NOTE: the cmake.sh installer writes cmake/ccmake/cpack/ctest into
# /bin as a side-effect, overwriting the /bin -> usr/bin symlink.
# Rescue the files and restore the system symlink.
RUN curl -o cmake.sh ${FILE_STORE}/iluvatar/${CMAKE_PKG} \
  && bash cmake.sh --skip-license --target /opt/cmake-corex \
  && rm cmake.sh \
  && if [ ! -L /bin ]; then \
       mv /bin/* /usr/bin/; \
       rmdir /bin && ln -s usr/bin /bin; \
     fi

# Environment variable
ENV COREX_ROOT=/usr/local/corex \
    CPATH=/usr/local/cuda-10.2/include
ENV PATH="${COREX_ROOT}/bin:/opt/cmake-corex/bin:${PATH}" \
    LD_LIBRARY_PATH="${COREX_ROOT}/lib"
